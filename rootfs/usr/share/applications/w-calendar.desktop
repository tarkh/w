[Desktop Entry]
Name=Calendar
Comment=Month view with today highlighted
# NB: no `sh -c` — a .desktop Exec does not treat ' as a quote character, so single
# quotes are stripped and the shell then chokes on the bare `(`. See quickshell-hub.md.
Exec=hyprctl dispatch "hl.dsp.global(\"quickshell:calendar\")"
Icon=office-calendar
Type=Application
Categories=Office;Calendar;
Keywords=calendar;date;month;day;today;
