[Desktop Entry]
Name=W Assistant
Name[ru]=Ассистент W
Comment=Ask W — the OS assistant (Super+W)
Comment[ru]=Спросить W — ассистент системы (Super+W)
# NB: no `sh -c` — a .desktop Exec does not treat ' as a quote character, so single
# quotes are stripped and the shell then chokes on the bare `(`. See quickshell-hub.md.
Exec=hyprctl dispatch "hl.dsp.global(\"quickshell:assistant\")"
Icon=assistant
Type=Application
Categories=System;Utility;
Keywords=ai;assistant;jarvis;chat;goose;w-ai;ask;
Keywords[ru]=ассистент;помощник;ии;чат;спросить;джарвис;ai;assistant;jarvis;chat;goose;w-ai;ask;
