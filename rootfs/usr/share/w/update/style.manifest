# style.manifest — config owned by mod_style (the w-style renderer + theme catalog).
# /etc/w/active-theme is admin-state the update preserves (a symlink into the theme
# catalog) — reset points it back to the baseline 'w' theme. The renderer library and
# the theme data are managed system paths. All per-user theme ARTIFACTS (gtk/qt/shell/
# hypr colours) are regenerated by `w-style apply user`, which w-reset runs after any
# home reset, so they are not enumerated here.
# Format: <path>\t<class>   class: managed | override  (trailing '/' = directory)
/etc/w/active-theme	override
/usr/lib/w/w-style/	managed
/usr/lib/w/w-theme/	managed
/etc/w/themes/	managed
# ~/.config/w/appearance.conf (BLUR/MOTION overrides, w-appearance) holds only
# per-user deviations, created on demand with no vendor default — class
# user-conf: `w-reset style` deletes it, and the home reset already triggers
# `w-style apply user` afterwards, so the drop renders live, no extra delegate
# needed (unlike power/nightlight).
/usr/share/w/defaults/appearance.schema	managed
.config/w/appearance.conf	user-conf
