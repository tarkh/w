# update.manifest — system config owned by mod_update (w-update check timer,
# pacman cache retention).
# Managed system paths (root to reset), restored from the W source. The `updates`
# bar block lives in the quickshell config (its own manifest).
# Format: <path>\t<class>
/etc/systemd/user/w-update-check.service	managed
/etc/systemd/user/w-update-check.timer	managed
/etc/systemd/system/paccache.service.d/10-w-retention.conf	managed
