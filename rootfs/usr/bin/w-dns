#!/usr/bin/env bash
# w-dns — W Linux DNS-over-TLS control
#
# Thin front over systemd-resolved. The catalog of resolvers and the active
# selection live in /etc/w/dns.conf (the source-of-truth, like w-style's theme
# configs); w-dns renders the chosen provider into
# /etc/systemd/resolved.conf.d/10-w-dns.conf (do NOT hand-edit that file) and
# restarts resolved. systemd-resolved speaks DNS-over-TLS only (no DoH).
# See security.md (point Е).

set -euo pipefail

CONF="/etc/w/dns.conf"
DROPIN="/etc/systemd/resolved.conf.d/10-w-dns.conf"

# shellcheck source=../lib/w/w-conf-lib.sh
source /usr/lib/w/w-conf-lib.sh
# Split into layers (update-system.md phase 3): the provider catalog and W's
# default selection live in /usr/share/w/defaults/dns.conf, /etc/w/dns.conf holds
# only this machine's deviations. Reads are therefore EFFECTIVE across the stack —
# dns.schema declares every key system-scope, so no user file can redirect the
# machine's resolver.
wconf_load dns   # one pass up front; the $(…) reads below are cache hits
conf_get() { wconf_get dns "$1" "${2:-}"; }

err() { echo "w-dns: $*" >&2; }
need_root() { [[ $EUID -eq 0 ]] || { err "this command requires root"; exit 1; }; }
# The admin file may legitimately be empty (or absent) now — what must exist is a
# resolver catalog somewhere in the stack.
need_conf() { wconf_has dns PROVIDER || { err "no DNS configuration in any layer (vendor file missing — run: sudo apply.sh --rootfs)"; exit 1; }; }

usage() {
  cat <<EOF
Usage: w-dns <command>

Info: Switch DNS provider and DNS-over-TLS mode (systemd-resolved).

Commands:
  status            Show selection + resolved state (resolvectl status)
  list              List available DoT providers from the catalog (* = active)
  provider <name>   Switch resolver (e.g. quad9 cloudflare mullvad google adguard)
  on                DoT = opportunistic  (W default; falls back if blocked)
  strict            DoT = yes            (guaranteed encryption; may break captive)
  off               System default: per-link DHCP DNS (removes the W override)
  apply             Re-render from $CONF (after hand-editing the catalog)
  help              Show this help

Catalog & selection: $CONF   Rendered (generated): $DROPIN

Exit codes:
  0  Success   1  Runtime error   2  Usage error

Examples:
  w-dns status
  sudo w-dns provider cloudflare
  sudo w-dns strict
EOF
}

# Writes go to the admin layer through the shared setter: it APPENDS a key the
# file does not have yet (the plain sed this replaced silently did nothing on the
# now-usually-empty admin file), writes atomically, and refuses a key locked by
# fleet policy.
set_kv() { need_root; wconf_set dns "$1" "$2"; }

render() {
  need_root
  need_conf
  local msg dot provider
  dot="$(conf_get DOT)"; provider="$(conf_get PROVIDER)"
  if [[ "$dot" == "off" ]]; then
    # System default: neutralise the W override so resolved serves whatever NM
    # pushes per-link (DHCP/VPN DNS). Empty DNS=/Domains= EXPLICITLY clear the
    # global resolver and ~. routing — needed because `reload` re-applies changed
    # settings but does NOT reset ones that merely vanish (a deleted file would
    # leave a stale global ~. until a full restart).
    install -d -m755 "$(dirname "$DROPIN")"
    cat > "$DROPIN" <<EOF
# W Linux — generated by w-dns. Do NOT edit; edit $CONF then run 'w-dns apply'
# (or w-dns provider/on/strict/off). See security.md (point Е).
# DoT=off: W override disabled — system default (per-link DHCP/VPN DNS).
[Resolve]
DNS=
Domains=
EOF
    msg="W override disabled -> system default (per-link DHCP DNS)"
  else
    local servers tls
    servers="$(conf_get "DNS_${provider}")"
    [[ -n "$servers" ]] || { err "unknown provider '${provider}' (see: w-dns list)"; exit 1; }
    case "$dot" in
      opportunistic) tls=opportunistic ;;
      strict)        tls=yes           ;;
      *) err "invalid DOT='${dot}' in $CONF (opportunistic|strict|off)"; exit 1 ;;
    esac
    install -d -m755 "$(dirname "$DROPIN")"
    cat > "$DROPIN" <<EOF
# W Linux — generated by w-dns. Do NOT edit; edit $CONF then run 'w-dns apply'
# (or w-dns provider/on/strict/off). See security.md (point Е).
[Resolve]
DNS=$servers
# Domains=~. routes ALL names to the chosen resolver, so per-link DHCP/ISP DNS no
# longer shadows it (the "global resolver" model). More specific per-link domains
# (e.g. a VPN's ~corp.example) still win; .local goes via mDNS, not here.
Domains=~.
DNSOverTLS=$tls
DNSSEC=allow-downgrade
EOF
    msg="provider '$provider', DoT '$dot' -> applied"
  fi
  # Apply live only when running under systemd (skipped in a chroot/install: the
  # drop-in is written and resolved starts enabled on first boot). Prefer reload
  # over restart: it re-reads the config with no resolution gap and dodges the
  # service start-limit on repeated toggles. If not yet running, start it.
  if [[ -d /run/systemd/system ]]; then
    if systemctl is-active --quiet systemd-resolved; then
      systemctl reload systemd-resolved
    else
      systemctl start systemd-resolved
    fi
  fi
  echo "w-dns: $msg"
}

cmd_status() {
  need_conf
  echo "Selection : provider=$(conf_get PROVIDER '?')  DoT=$(conf_get DOT '?')"
  echo "            (layered config; per-value origin: w-conf cat dns)"
  echo
  resolvectl status
}

cmd_list() {
  need_conf
  echo "Available DoT providers (* = active):"
  local n active; active="$(conf_get PROVIDER)"
  # The catalog is whatever DNS_* keys the LAYERS hold, merged: W's own entries
  # come from the vendor layer and an admin-added DNS_<name> from /etc/w/dns.conf
  # shows up beside them with no code change (that is the point of key-wise merging).
  # Must be wconf_keys, not a layer-scoped lookup — after the split the vendor layer
  # holds the catalog and a system-scoped enumeration returns nothing.
  while IFS= read -r n; do
    n="${n#DNS_}"
    [[ "$n" == "$active" ]] && printf '  * %s\n' "$n" || printf '    %s\n' "$n"
  done < <(wconf_keys dns DNS_)
}

cmd_provider() {
  need_root
  need_conf
  local name="$1"
  [[ -n "$(conf_get "DNS_${name}")" ]] || { err "unknown provider '$name' (see: w-dns list)"; exit 1; }
  set_kv PROVIDER "$name"
  render
}

cmd_mode() { need_root; set_kv DOT "$1"; render; }

case "${1:-}" in
  status)         cmd_status                       ;;
  list)           cmd_list                         ;;
  provider)       [[ -n "${2:-}" ]] || { err "provider requires a name"; usage; exit 2; }
                  cmd_provider "$2"                ;;
  on)             cmd_mode opportunistic           ;;
  strict)         cmd_mode strict                  ;;
  off)            cmd_mode off                     ;;
  apply)          render                           ;;
  help|-h|--help) usage                            ;;
  "")             usage; exit 2                     ;;
  *)              err "unknown command: $1"; usage; exit 2 ;;
esac
