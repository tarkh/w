#!/usr/bin/env bash
# w-kernel — W Linux kernel selection & hardening control
#
# Front-end over pacman + the bootloader + sysctl for: switching the active kernel
# (zen / vanilla / LTS, keeping DKMS headers paired) and toggling the hardening
# profile as a whole (sysctl drop-ins + boot cmdline).
# Raw drop-ins in /etc/sysctl.d/90-w-*.conf remain the source of truth.
#
# BOOTLOADER-AWARE (the same split w-mkinitcpio and w-rollback make, keyed off
# /etc/default/limine — only the encrypted install path deploys it):
#   • GRUB (plain installs): the default kernel is GRUB_TOP_LEVEL and the cmdline is
#     GRUB_CMDLINE_LINUX_DEFAULT, both in /etc/default/grub, applied by grub-mkconfig.
#   • Limine (encrypted installs): entries are generated by limine-entry-tool from the
#     INSTALLED kernels, the cmdline is /etc/kernel/cmdline, and the default entry is
#     pinned by our post.d hook 50-w-default-entry. The hook — not a one-shot sed — is
#     the only durable place for that choice: limine-update and limine-snapper-sync
#     regenerate limine.conf asynchronously and reset default_entry every time. So
#     `set` records the choice in /etc/w/kernel.conf (DEFAULT_KERNEL=<pkgbase>), which
#     the hook reads on every regeneration, and then runs limine-update to apply it.
#     grub is installed on both paths (it is in base.txt), so calling grub-mkconfig on
#     a Limine system would SUCCEED and write a config nothing boots — which is exactly
#     how kernel selection and cmdline hardening were silently inert there before.
#
# Switching is deliberately non-destructive: every installed kernel stays a bootable
# menu entry, so a kernel that misbehaves (a regressed driver, a DKMS module without a
# patch for the new series yet) is one reboot away from being escaped, offline and
# without a download. That is the whole point of keeping LTS installed next to zen —
# `remove` exists to reclaim the space deliberately, never as a side effect of `set`.

set -euo pipefail

# The package-transaction seam (installer.md §5 layer 2): switching kernels pulls
# the kernel, its headers and every DKMS rebuild behind them, and a stall halfway
# through leaves the machine between two kernels. Until Ф.3 shipped the seam to
# /usr/lib/w this script had no access to it and ran bare pacman.
# shellcheck source=../lib/w/w-pac-lib.sh
source /usr/lib/w/w-pac-lib.sh

# ── Constants ──────────────────────────────────────────────────────────────────
GRUB_DEFAULT_FILE="/etc/default/grub"
GRUB_CFG="/boot/grub/grub.cfg"
LIMINE_DEFAULT="/etc/default/limine"
LIMINE_CMDLINE="/etc/kernel/cmdline"
KERNEL_CONF="/etc/w/kernel.conf"
# World-readable mirror of the kernel that actually boots next. Both bootloaders keep
# that answer in a root-only file — the ESP is mounted dmask=0077 (limine.conf) and
# grub-mkconfig writes grub.cfg under `umask 077` unconditionally — so the Hub, which
# reads `list --porcelain` as the desktop user, resolved NO default and rendered "—"
# on every fresh install of either kind. Derived state, not a choice: it is written
# from the same value that was just pinned (see refresh_boot and the Limine post.d
# hook 50-w-default-entry), which is why it lives in /var/lib/w and not /etc/w.
STATE_DEFAULT="/var/lib/w/kernel.default"
SYSCTL_DIR="/etc/sysctl.d"
HARDEN_DROPINS=(90-w-kernel.conf 90-w-fs.conf 90-w-net.conf)
HARDEN_CMDLINE="init_on_alloc=1 init_on_free=1 slab_nomerge \
randomize_kstack_offset=1 page_alloc.shuffle=1 vsyscall=none debugfs=off"

# Short name -> packages / boot image. LTS is the hardware-compatibility escape hatch:
# an older series still carrying drivers a newer one regressed or has not landed yet.
KERNEL_ORDER=(zen vanilla lts)
declare -A KERNEL_PKG=([zen]=linux-zen [vanilla]=linux [lts]=linux-lts)
declare -A HEADERS_PKG=([zen]=linux-zen-headers [vanilla]=linux-headers [lts]=linux-lts-headers)
declare -A KERNEL_IMG=([zen]=/boot/vmlinuz-linux-zen [vanilla]=/boot/vmlinuz-linux [lts]=/boot/vmlinuz-linux-lts)

err() { echo "w-kernel: $*" >&2; }
need_root() { [[ $EUID -eq 0 ]] || { err "this command requires root"; exit 1; }; }

usage() {
  cat <<EOF
Usage: w-kernel <command> [options]

Info: Select the active kernel and toggle the hardening profile.

Commands:
  list [--porcelain]        Show the known kernels, which are installed, the default
                            and the running one
  set <zen|vanilla|lts>     Install the kernel (+paired headers) and make it default
  remove <zen|vanilla|lts>  Uninstall a kernel (+headers); refuses the running or
                            the default one
  harden <on|off|status>    Toggle the whole hardening profile (sysctl + cmdline)
                            (status takes --porcelain)
  help                      Show this help

Porcelain:
  list --porcelain          TSV, header + one row per kernel:
                            name  pkg  version  installed  default  running
  harden status --porcelain TSV, header + one row: state(on|off|mixed)  pending(yes|no)

Exit codes:
  0  Success
  1  Runtime error
  2  Usage error

Examples:
  sudo w-kernel set lts
  sudo w-kernel harden on
EOF
}

# ── Bootloader ─────────────────────────────────────────────────────────────────
# Same probe mod_snapshots, fix_snapper and w-rollback use, so every W tool agrees
# about which stack this machine boots.
boot_path() { [[ -f "$LIMINE_DEFAULT" ]] && echo limine || echo grub; }

limine_esp() {
  local p=""
  [[ -f "$LIMINE_DEFAULT" ]] && p="$(awk -F'"' '/^ESP_PATH=/{print $2}' "$LIMINE_DEFAULT")"
  echo "${p:-/boot/efi}"
}

# Apply whatever we just wrote to the bootloader's own config. On Limine this fires
# limine-entry-tool's post.d hooks — 50-w-default-entry (repin) then
# 90-limine-enroll-config (re-enroll the Secure Boot config hash over the corrected
# file), which is why the two must stay in that order.
refresh_boot() {
  if [[ "$(boot_path)" == limine ]]; then
    echo "==> Regenerating Limine config (limine-update)..."
    limine-update
  else
    echo "==> Regenerating GRUB config..."
    grub-mkconfig -o /boot/grub/grub.cfg
  fi
  # Only now is the pinned default final — refresh the readable mirror against it.
  # On Limine 50-w-default-entry has already written the same value (it fires inside
  # limine-update); doing it here too is what covers GRUB, where no such hook exists,
  # and it is how a fresh install of EITHER kind gets a mirror at all: mod_harden runs
  # `w-kernel harden on` on every apply, and that lands here.
  mirror_default
}

# Record what boots next where an unprivileged reader can see it. Root-only and
# best-effort by design: a stale badge must never be the reason a kernel switch,
# a hardening toggle or an apply run fails.
mirror_default() {
  [[ $EUID -eq 0 ]] || return 0
  local v
  v="$(default_pkg)"
  [[ -n "$v" ]] || return 0
  [[ "$(cat "$STATE_DEFAULT" 2>/dev/null || true)" == "$v" ]] && return 0
  install -d -m 755 "$(dirname "$STATE_DEFAULT")" 2>/dev/null || return 0
  printf '%s\n' "$v" > "$STATE_DEFAULT" 2>/dev/null || return 0
  chmod 644 "$STATE_DEFAULT" 2>/dev/null || true
  return 0
}

# The alpm hook 95-w-update-refresh already re-ran `w-update check` for every logged-in
# user DURING the pacman transaction — that is, before the new default was written, so
# the "reboot owed" flag it computed is stale by one step. Re-run the same fan-out now
# that the choice is final, so the bar's indicator flips to the reboot glyph at once
# instead of at the next tick. Best-effort: a stale badge must never fail a switch.
refresh_indicator() {
  [[ -x /usr/lib/w/w-update-refresh ]] && /usr/lib/w/w-update-refresh || true
}

# ── State ──────────────────────────────────────────────────────────────────────
# Validate a kernel short name before it is used as an array subscript: an EMPTY
# subscript is a hard "bad array subscript" error on an associative array, so a bare
# `w-kernel set` would die with a bash diagnostic instead of our usage message.
# [[ ]] short-circuits, so the expansion only happens once the name is known non-empty.
require_name() {
  local n="${1:-}"
  [[ -n "$n" && -n "${KERNEL_PKG[$n]:-}" ]] \
    || { err "unknown kernel: '$n' (use zen|vanilla|lts)"; exit 2; }
}

name_of_pkg() {
  local n
  for n in "${KERNEL_ORDER[@]}"; do
    [[ "${KERNEL_PKG[$n]}" == "$1" ]] && { echo "$n"; return 0; }
  done
  return 1
}

# Which package the RUNNING kernel came from. /usr/lib/modules/<ver>/pkgbase is written
# by the kernel packages themselves — authoritative, unlike parsing `uname -r` (whose
# suffix is a naming convention, not a contract). Empty when the modules tree is gone
# (an in-place upgrade) or the kernel is not one of ours.
running_pkg() {
  local f
  f="/usr/lib/modules/$(uname -r)/pkgbase"
  [[ -r "$f" ]] && tr -d '[:space:]' < "$f" || true
}

# Which package the machine will boot NEXT.
default_pkg() {
  local v="" conf img n
  if [[ "$(boot_path)" == limine ]]; then
    if [[ -r "$KERNEL_CONF" ]]; then
      v="$(sed -n 's/^DEFAULT_KERNEL="\?\([^"]*\)"\?.*/\1/p' "$KERNEL_CONF" | head -1)"
    fi
    # Never chosen through this tool (a pre-existing install): the truth is whatever
    # 50-w-default-entry last pinned — read it rather than assume the shipped default.
    if [[ -z "$v" ]]; then
      conf="$(limine_esp)/limine.conf"
      [[ -r "$conf" ]] && v="$(sed -n 's#^default_entry:[[:space:]]*##p' "$conf" | head -1 | sed 's#.*/##')"
    fi
  else
    if [[ -r "$GRUB_DEFAULT_FILE" ]]; then
      img="$(sed -n 's/^GRUB_TOP_LEVEL="\?\([^"]*\)"\?/\1/p' "$GRUB_DEFAULT_FILE" | head -1)"
      for n in "${KERNEL_ORDER[@]}"; do
        [[ "${KERNEL_IMG[$n]}" == "$img" ]] && { v="${KERNEL_PKG[$n]}"; break; }
      done
    fi
    # Never chosen through this tool — the symmetric case to the Limine branch above,
    # and the NORMAL state of a fresh plain install: the installer never writes
    # GRUB_TOP_LEVEL (mod_grub sets only theme/timeout keys), so GRUB boots whatever
    # 10_linux discovered first. Read that out of the generated config instead of
    # guessing or reporting "unknown" — the first `linux …/vmlinuz-<pkgbase>` line is
    # the top-level default entry, exactly as `default_entry:` is on Limine. Without
    # this the Hub's kernel row would read "—" on every plain install, which is the
    # one thing the panel is not allowed to do: show a state that is not the truth.
    if [[ -z "$v" && -r "$GRUB_CFG" ]]; then
      v="$(sed -n 's#^[[:space:]]*linux[[:space:]].*/vmlinuz-\([A-Za-z0-9._-]\+\).*#\1#p' "$GRUB_CFG" | head -1)"
    fi
  fi
  # Every source above is root-only on BOTH stacks (ESP dmask=0077, grub.cfg 0600),
  # and the caller that matters most — the Hub's kernel row — runs as the desktop
  # user. Fall back to the mirror last: root still answers from the live config, so
  # a mirror that ever went stale can never outrank the truth for the tool that
  # writes it. See STATE_DEFAULT.
  if [[ -z "$v" && -r "$STATE_DEFAULT" ]]; then
    v="$(tr -d '[:space:]' < "$STATE_DEFAULT")"
  fi
  echo "$v"
}

# ── list ───────────────────────────────────────────────────────────────────────
cmd_list() {
  local porcelain=false
  [[ "${1:-}" == "--porcelain" ]] && porcelain=true

  local def run name pkg ver installed
  def="$(default_pkg)"; run="$(running_pkg)"

  if [[ "$porcelain" == true ]]; then
    printf 'name\tpkg\tversion\tinstalled\tdefault\trunning\n'
    for name in "${KERNEL_ORDER[@]}"; do
      pkg="${KERNEL_PKG[$name]}"
      if ver="$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')" && [[ -n "$ver" ]]; then
        installed=yes
      else
        installed=no; ver="-"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$pkg" "$ver" "$installed" \
        "$([[ "$pkg" == "$def" ]] && echo yes || echo no)" \
        "$([[ "$pkg" == "$run" ]] && echo yes || echo no)"
    done
    return 0
  fi

  echo "Running kernel : $(uname -r)${run:+ ($(name_of_pkg "$run" 2>/dev/null || echo "$run"))}"
  echo "Default ($(boot_path)) : ${def:-(bootloader discovery order)}"
  echo "Installed:"
  for name in "${KERNEL_ORDER[@]}"; do
    pkg="${KERNEL_PKG[$name]}"
    if pacman -Qq "$pkg" &>/dev/null; then
      echo "  - $name ($pkg $(pacman -Q "$pkg" | awk '{print $2}'))"
    fi
  done
  [[ -n "$def" && -n "$run" && "$def" != "$run" ]] \
    && echo "Reboot to switch to the default kernel."
  return 0
}

# ── Kernel selection ───────────────────────────────────────────────────────────
set_default() {
  local name="$1"
  local pkg="${KERNEL_PKG[$name]}" img="${KERNEL_IMG[$name]}"
  if [[ "$(boot_path)" == limine ]]; then
    echo "==> Recording $pkg as the default boot entry (50-w-default-entry reads this)..."
    mkdir -p "$(dirname "$KERNEL_CONF")"
    if [[ -f "$KERNEL_CONF" ]] && grep -q '^DEFAULT_KERNEL=' "$KERNEL_CONF"; then
      sed -i "s|^DEFAULT_KERNEL=.*|DEFAULT_KERNEL=\"$pkg\"|" "$KERNEL_CONF"
    else
      [[ -f "$KERNEL_CONF" ]] || echo "# Managed by w-kernel. Read by the Limine post.d hook 50-w-default-entry." > "$KERNEL_CONF"
      echo "DEFAULT_KERNEL=\"$pkg\"" >> "$KERNEL_CONF"
    fi
  else
    echo "==> Making $name the default boot entry..."
    if grep -q '^GRUB_TOP_LEVEL=' "$GRUB_DEFAULT_FILE" 2>/dev/null; then
      sed -i "s|^GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL=\"$img\"|" "$GRUB_DEFAULT_FILE"
    else
      echo "GRUB_TOP_LEVEL=\"$img\"" >> "$GRUB_DEFAULT_FILE"
    fi
  fi
  refresh_boot
}

cmd_set() {
  local name="${1:-}"
  require_name "$name"
  need_root

  local kpkg="${KERNEL_PKG[$name]}" hpkg="${HEADERS_PKG[$name]}"

  echo "==> Installing $kpkg + $hpkg (DKMS rebuilds against headers)..."
  w_pac -S --needed --noconfirm "$kpkg" "$hpkg"

  set_default "$name"
  refresh_indicator

  echo "Done. Reboot into '$name'. Other installed kernels remain available in the boot menu."
}

cmd_remove() {
  local name="${1:-}"
  require_name "$name"
  need_root

  local kpkg="${KERNEL_PKG[$name]}" hpkg="${HEADERS_PKG[$name]}"
  pacman -Qq "$kpkg" &>/dev/null || { err "$name ($kpkg) is not installed"; exit 1; }
  [[ "$(running_pkg)" == "$kpkg" ]] && { err "refusing: $name is the running kernel"; exit 1; }
  [[ "$(default_pkg)" == "$kpkg" ]] && { err "refusing: $name is the default boot kernel (switch first: w-kernel set <other>)"; exit 1; }

  # Removal is local work: no mirror is involved, so there is nothing for the w_pac
  # seam to retry against (the same reasoning that keeps `pacman -U` out of it).
  local -a targets=("$kpkg")
  pacman -Qq "$hpkg" &>/dev/null && targets+=("$hpkg")
  echo "==> Removing ${targets[*]}..."
  pacman -Rns --noconfirm "${targets[@]}"

  refresh_boot
  refresh_indicator
  echo "Done. '$name' is gone from the boot menu."
}

# ── Hardening profile ──────────────────────────────────────────────────────────
# Two cmdline homes, one token set. GRUB keeps its tokens inside the quoted
# GRUB_CMDLINE_LINUX_DEFAULT (preserving splash/quiet from Plymouth); Limine reads a
# bare whitespace-separated line from /etc/kernel/cmdline, shared by every kernel and
# every snapshot entry (limine-snapper-sync only overrides rootflags= per snapshot).
_grub_cmdline_has() {
  grep -qE "^GRUB_CMDLINE_LINUX_DEFAULT=\".*(^|[\" ])${1//./\\.}([\" ]|\$)" "$GRUB_DEFAULT_FILE" 2>/dev/null
}
_grub_cmdline_add() {
  grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$GRUB_DEFAULT_FILE" \
    || echo 'GRUB_CMDLINE_LINUX_DEFAULT=""' >> "$GRUB_DEFAULT_FILE"
  local tok
  for tok in $HARDEN_CMDLINE; do
    _grub_cmdline_has "$tok" && continue
    sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 ${tok}\"|" "$GRUB_DEFAULT_FILE"
  done
  _grub_cmdline_tidy
}
_grub_cmdline_remove() {
  local tok
  for tok in $HARDEN_CMDLINE; do
    sed -i "s|\([\" ]\)${tok//./\\.}\([\" ]\)|\1\2|g" "$GRUB_DEFAULT_FILE"
  done
  _grub_cmdline_tidy
}
_grub_cmdline_tidy() {
  sed -i 's|^\(GRUB_CMDLINE_LINUX_DEFAULT="\) *|\1|; s|  *\("\)$|\1|; s|\(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*\)  *|\1 |g' "$GRUB_DEFAULT_FILE"
}

# Strip every hardening token, then re-add them for `add`. One code path for both
# directions keeps the file idempotent whichever way it is toggled, and preserves the
# order and spacing of the boot-critical tokens (rd.luks.name/root/rootflags) around it.
_limine_cmdline_apply() {
  local mode="$1" tok h keep
  local -a cur=() out=()
  [[ -f "$LIMINE_CMDLINE" ]] || : > "$LIMINE_CMDLINE"
  # read returns 1 on a file without a trailing newline but still fills the array.
  read -r -a cur < "$LIMINE_CMDLINE" || true
  for tok in "${cur[@]}"; do
    keep=yes
    for h in $HARDEN_CMDLINE; do [[ "$tok" == "$h" ]] && { keep=no; break; }; done
    [[ "$keep" == yes ]] && out+=("$tok")
  done
  if [[ "$mode" == add ]]; then
    for h in $HARDEN_CMDLINE; do out+=("$h"); done
  fi
  printf '%s\n' "${out[*]}" > "$LIMINE_CMDLINE"
}
_limine_cmdline_has() {
  grep -qE "(^|[[:space:]])${1//./\\.}([[:space:]]|\$)" "$LIMINE_CMDLINE" 2>/dev/null
}

cmdline_add()    { if [[ "$(boot_path)" == limine ]]; then _limine_cmdline_apply add;    else _grub_cmdline_add;    fi; }
cmdline_remove() { if [[ "$(boot_path)" == limine ]]; then _limine_cmdline_apply remove; else _grub_cmdline_remove; fi; }
cmdline_has()    { if [[ "$(boot_path)" == limine ]]; then _limine_cmdline_has "$1";     else _grub_cmdline_has "$1"; fi; }

# What the kernel is actually running with right now — the configured set only takes
# effect at the next boot, so the two disagreeing IS the "reboot owed" signal.
cmdline_live_has() { grep -qE "(^|[[:space:]])${1//./\\.}([[:space:]]|\$)" /proc/cmdline; }

# state=on|off|mixed over BOTH halves (drop-ins + cmdline); pending=yes when the
# configured cmdline and the live one disagree about any token.
harden_state() {
  local f tok on=0 off=0 conf_on=0 conf_off=0 pending=no
  for f in "${HARDEN_DROPINS[@]}"; do
    if [[ -f "$SYSCTL_DIR/$f" ]]; then ((on++)) || true; else ((off++)) || true; fi
  done
  for tok in $HARDEN_CMDLINE; do
    if cmdline_has "$tok"; then ((conf_on++)) || true; else ((conf_off++)) || true; fi
    if cmdline_has "$tok" && ! cmdline_live_has "$tok"; then pending=yes
    elif ! cmdline_has "$tok" && cmdline_live_has "$tok"; then pending=yes; fi
  done
  local state=mixed
  if   ((off == 0 && conf_off == 0)); then state=on
  elif ((on  == 0 && conf_on  == 0)); then state=off
  fi
  echo "$state" "$pending"
}

cmd_harden() {
  local action="${1:-}"
  case "$action" in
    on)
      need_root
      local f
      for f in "${HARDEN_DROPINS[@]}"; do
        [[ -f "$SYSCTL_DIR/$f.disabled" ]] && mv "$SYSCTL_DIR/$f.disabled" "$SYSCTL_DIR/$f"
      done
      sysctl --system >/dev/null
      cmdline_add
      refresh_boot
      echo "Hardening ON. Reboot required for cmdline params."
      ;;
    off)
      need_root
      local f
      for f in "${HARDEN_DROPINS[@]}"; do
        [[ -f "$SYSCTL_DIR/$f" ]] && mv "$SYSCTL_DIR/$f" "$SYSCTL_DIR/$f.disabled"
      done
      cmdline_remove
      refresh_boot
      echo "Hardening OFF. sysctl values persist until reboot; cmdline params removed."
      ;;
    status)
      local st pend
      read -r st pend < <(harden_state)
      if [[ "${2:-}" == "--porcelain" ]]; then
        printf 'state\tpending\n%s\t%s\n' "$st" "$pend"
        return 0
      fi
      local f tok
      echo "Profile        : $st"
      echo "sysctl drop-ins:"
      for f in "${HARDEN_DROPINS[@]}"; do
        if [[ -f "$SYSCTL_DIR/$f" ]]; then echo "  [on]  $f"
        elif [[ -f "$SYSCTL_DIR/$f.disabled" ]]; then echo "  [off] $f"
        else echo "  [--]  $f (missing)"; fi
      done
      echo "cmdline params ($(boot_path)):"
      for tok in $HARDEN_CMDLINE; do
        if cmdline_has "$tok"; then echo "  [on]  $tok"; else echo "  [off] $tok"; fi
      done
      [[ "$pend" == yes ]] && echo "Reboot required — the running cmdline does not match the configured one."
      ;;
    *) err "usage: w-kernel harden <on|off|status>"; exit 2 ;;
  esac
  return 0
}

# ── Dispatch ───────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)            shift; cmd_list "$@" ;;
  set)             shift; cmd_set "$@" ;;
  remove)          shift; cmd_remove "$@" ;;
  harden)          shift; cmd_harden "$@" ;;
  help|--help|-h)  usage; exit 0 ;;
  "")              usage >&2; exit 2 ;;
  *)               err "unknown command: $1"; usage >&2; exit 2 ;;
esac
