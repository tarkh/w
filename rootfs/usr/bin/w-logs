#!/usr/bin/env bash
# w-logs — W Linux unified log retention control
#
# One number, every log node. W stores logs in three places — the systemd journal,
# flat files under /var/log/* (any daemon the user installs), and W's own logs
# under /var/log/w/. Each has its own rotation mechanism; w-logs drives all three
# from a single source-of-truth (/etc/w/logs.conf) so the user only ever says
# "keep N days" and the whole system obeys.
#
#   journal     -> /etc/systemd/journald.conf.d/10-w-retention.conf  (MaxRetentionSec
#                  + SystemMaxUse), enforced by journald itself.
#   /var/log/*  -> a W region in /etc/logrotate.conf (global defaults inherited by
#                  every drop-in) + /etc/logrotate.d/zz-w-catchall (a failsafe glob
#                  over /var/log/*.log for daemons that ship no logrotate snippet).
#                  Driven by logrotate.timer (systemd, not cron).
#   /var/log/w/ -> /etc/tmpfiles.d/w-logs.conf, cleaned by systemd-tmpfiles-clean.timer.
#
# Generated files carry a "do NOT edit" banner — edit /etc/w/logs.conf, then
# `w-logs apply`. See w-logs.md. btrfs note: /var/log is its own subvolume
# (@var_log, kept out of snapper) so trimming logs never churns root snapshots.

set -euo pipefail

CONF="/etc/w/logs.conf"

# shellcheck source=../lib/w/w-conf-lib.sh
source /usr/lib/w/w-conf-lib.sh
# Split into layers (update-system.md phase 3): W's retention default lives in
# /usr/share/w/defaults/logs.conf, /etc/w/logs.conf holds this machine's deviation.
# logs.schema marks every key system-scope — one user must not decide how long the
# machine keeps everyone's logs.
wconf_load logs  # one pass up front; the $(…) reads below are cache hits
conf_get() { wconf_get logs "$1" "${2:-}"; }

JOURNAL_DROPIN="/etc/systemd/journald.conf.d/10-w-retention.conf"
TMPFILES="/etc/tmpfiles.d/w-logs.conf"
LOGROTATE_CONF="/etc/logrotate.conf"
LOGROTATE_CATCHALL="/etc/logrotate.d/zz-w-catchall"
WLOG_DIR="/var/log/w"
MARK_BEGIN="# >>> w-logs (generated from /etc/w/logs.conf) >>>"
MARK_END="# <<< w-logs <<<"

err() { echo "w-logs: $*" >&2; }
need_root() { [[ $EUID -eq 0 ]] || { err "this command requires root"; exit 1; }; }
need_conf() { wconf_has logs RETENTION_DAYS || { err "no log-retention policy in any layer (vendor file missing — run: sudo apply.sh --rootfs)"; exit 1; }; }

usage() {
  cat <<EOF
Usage: w-logs <command>

Info: Set how long W keeps logs (journal + /var/log + W's own logs), one policy.

Commands:
  status               Show usage + current retention across all log nodes (default)
  keep <days>          Keep <days> of history everywhere, then apply
  limit <size>|off     Cap size (journal total / logrotate per-file); off clears it
  vacuum time <span>   Trim the journal NOW to a kept span (e.g. 2w, 30d, 6month)
  vacuum size <size>   Trim the journal NOW to a max total size (e.g. 500M, 2G)
  apply                Re-render every node from $CONF (after hand-editing it)
  show [unit] [-p P] [-n N]   Read recent journal (passthrough to journalctl)
  help                 Show this help

Policy source: $CONF   (generated files carry a do-NOT-edit banner)

Exit codes:
  0  Success   1  Runtime error   2  Usage error

Examples:
  w-logs status
  sudo w-logs keep 14
  sudo w-logs limit 1G
  sudo w-logs vacuum time 7d
EOF
}

# Writes land in the admin layer via the shared setter (appends an absent key).
set_kv() { need_root; wconf_set logs "$1" "$2"; }

# ── Renderers ──────────────────────────────────────────────────────────────────

render_journal() {
  local days="$1" size="$2"
  install -d -m755 "$(dirname "$JOURNAL_DROPIN")"
  {
    echo "# W Linux — generated by w-logs. Do NOT edit; edit $CONF then 'w-logs apply'."
    echo "[Journal]"
    # MaxRetentionSec is a time floor on kept history; write seconds to avoid any
    # ambiguity in unit parsing. SystemMaxUse is a total budget for the whole
    # journal directory (only set when the user asked for a size ceiling).
    echo "MaxRetentionSec=$((days * 86400))"
    [[ -n "$size" ]] && echo "SystemMaxUse=$size"
    : # keep this brace-group's exit status 0 (a false [[ ]] above must not abort set -e)
  } > "$JOURNAL_DROPIN"
}

render_tmpfiles() {
  local days="$1"
  install -d -m755 "$(dirname "$TMPFILES")"
  {
    echo "# W Linux — generated by w-logs. Do NOT edit; edit $CONF then 'w-logs apply'."
    echo "# Age-clean W's own flat logs; run by systemd-tmpfiles-clean.timer. The"
    echo "# directory itself is kept (no age on the 'd' line); files under it older"
    echo "# than the retention window are removed."
    printf 'd %s 0755 root root -\n' "$WLOG_DIR"
    printf 'e %s - - - %dd\n' "$WLOG_DIR" "$days"
  } > "$TMPFILES"
}

# The logrotate global defaults every drop-in inherits. We patch a marked region
# into /etc/logrotate.conf immediately before its `include /etc/logrotate.d` line,
# so our directives are the most-recent globals when the drop-ins are parsed (they
# win over the package's stock weekly/rotate 4). Idempotent: an existing region is
# stripped first.
render_logrotate_globals() {
  local days="$1" size="$2"
  [[ -f "$LOGROTATE_CONF" ]] || printf 'include /etc/logrotate.d\n' > "$LOGROTATE_CONF"

  local region
  region="$MARK_BEGIN
# W drives log retention from $CONF — do NOT hand-edit this region.
daily
rotate $days
maxage $days
dateext
compress
delaycompress
notifempty
missingok"
  if [[ -n "$size" ]]; then region+=$'\n'"maxsize $size"; fi
  region+=$'\n'"$MARK_END"

  MARK_BEGIN="$MARK_BEGIN" MARK_END="$MARK_END" REGION="$region" \
    awk '
      $0 == ENVIRON["MARK_BEGIN"] { skip=1 }
      skip { if ($0 == ENVIRON["MARK_END"]) skip=0; next }
      !done && $1 == "include" { print ENVIRON["REGION"]; done=1 }
      { print }
      END { if (!done) print ENVIRON["REGION"] }
    ' "$LOGROTATE_CONF" > "$LOGROTATE_CONF.w-tmp"
  cat "$LOGROTATE_CONF.w-tmp" > "$LOGROTATE_CONF"
  rm -f "$LOGROTATE_CONF.w-tmp"
}

# Failsafe catch-all: rotate any /var/log/*.log a daemon writes WITHOUT shipping its
# own logrotate snippet. We cannot use a bare `/var/log/*.log` glob — logrotate
# treats a file that another snippet already rotates (e.g. bootlog's boot.log) as a
# duplicate, and that error makes it skip our WHOLE catch-all (the failsafe would
# then silently cover nothing). So we enumerate the real orphans: every /var/log/*.log
# on disk that no other logrotate config claims. Regenerated on `w-logs apply` and
# before each rotation (logrotate.service drop-in), so logs from software installed
# after setup get picked up. Retention/compression come from the inherited W globals.
render_logrotate_catchall() {
  install -d -m755 "$(dirname "$LOGROTATE_CATCHALL")"

  # Patterns already claimed by any other logrotate config (literal paths or globs).
  local -a claimed=()
  local cfg tok
  shopt -s nullglob
  for cfg in "$LOGROTATE_CONF" /etc/logrotate.d/*; do
    [[ "$cfg" == "$LOGROTATE_CATCHALL" || ! -f "$cfg" ]] && continue
    while read -r tok; do claimed+=("$tok"); done \
      < <(grep -oE '/var/log[^[:space:]{}]*' "$cfg" 2>/dev/null)
  done

  # /var/log/*.log files no one else rotates.
  local -a orphans=()
  local f c hit
  for f in /var/log/*.log; do
    [[ -f "$f" ]] || continue
    hit=0
    for c in "${claimed[@]}"; do
      # literal equality OR glob match ($c unquoted = pattern)
      # shellcheck disable=SC2053
      [[ "$f" == "$c" || "$f" == $c ]] && { hit=1; break; }
    done
    ((hit)) || orphans+=("$f")
  done
  shopt -u nullglob

  {
    echo "# W Linux — generated by w-logs. Do NOT edit; edit $CONF then 'w-logs apply'."
    echo "# Failsafe: orphan /var/log/*.log (rotated by no other snippet) bound to the W"
    echo "# retention policy so a daemon that set up no rotation cannot fill the disk."
    echo "# Refreshed before each run + on 'w-logs apply' — listing files is deliberate"
    echo "# (a bare glob would collide with package snippets and disable the whole file)."
    if ((${#orphans[@]})); then
      printf '%s\n' "${orphans[@]}"
      echo "{"
      echo "    missingok"
      echo "    notifempty"
      echo "}"
    else
      echo "# (none right now — every /var/log/*.log is already covered elsewhere)"
    fi
  } > "$LOGROTATE_CATCHALL"
}

render() {
  need_root
  need_conf
  local days size
  days="$(conf_get RETENTION_DAYS 30)"; days="${days:-30}"
  size="$(conf_get MAX_SIZE)"
  [[ "$days" =~ ^[0-9]+$ && "$days" -ge 1 ]] || { err "RETENTION_DAYS must be a positive integer (got '${days}')"; exit 1; }
  if [[ -n "$size" ]] && ! [[ "$size" =~ ^[0-9]+[KMG]$ ]]; then
    err "MAX_SIZE must be a number plus K/M/G (e.g. 500M), or empty (got '${size}')"; exit 1
  fi

  render_journal "$days" "$size"
  render_tmpfiles "$days"
  render_logrotate_globals "$days" "$size"
  render_logrotate_catchall

  # Apply live only under a running systemd (skipped in chroot/install: files are
  # written and the units come up enabled on first boot). RELOAD journald, never
  # restart: reload re-reads the retention config with no logging gap and, crucially,
  # does not count against the restart start-limit — repeated retention changes (or
  # the AI/Hub actuation path) would otherwise trip it and kill journald. An immediate
  # trim is a separate, explicit action (`w-logs vacuum`).
  if [[ -d /run/systemd/system ]]; then
    systemctl reload systemd-journald 2>/dev/null || true
    systemd-tmpfiles --create "$TMPFILES" 2>/dev/null || true
  fi
  echo "w-logs: retention set to ${days} day(s)${size:+, size cap ${size}} across journal, /var/log, and /var/log/w."
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_status() {
  need_conf
  local days size
  days="$(conf_get RETENTION_DAYS '?')"; size="$(conf_get MAX_SIZE)"
  echo "Policy   : keep ${days} day(s)${size:+, size cap ${size}}   (origin: w-conf cat logs)"
  echo

  echo "Journal (systemd):"
  local ju
  ju="$(journalctl --disk-usage 2>/dev/null | sed -n 's/^Archived and active journals take up //p')"
  echo "  disk usage    : ${ju:-unknown (need journal read access)}"
  if [[ -r "$JOURNAL_DROPIN" ]]; then
    local mrs smu
    mrs="$(sed -n 's/^MaxRetentionSec=//p' "$JOURNAL_DROPIN")"
    smu="$(sed -n 's/^SystemMaxUse=//p' "$JOURNAL_DROPIN")"
    [[ -n "$mrs" ]] && echo "  keep          : $((mrs / 86400)) day(s)" || true
    [[ -n "$smu" ]] && echo "  size cap      : $smu" || true
  else
    echo "  retention     : not rendered yet (run: sudo w-logs apply)"
  fi
  echo

  echo "/var/log flat files (logrotate):"
  if command -v logrotate >/dev/null 2>&1; then
    local nextrun
    nextrun="$(systemctl list-timers logrotate.timer --no-pager --no-legend 2>/dev/null | awk '{print $1, $2, $3}')"
    echo "  timer         : $(systemctl is-active logrotate.timer 2>/dev/null || echo unknown)${nextrun:+, next $nextrun}"
    grep -q "^$MARK_BEGIN" "$LOGROTATE_CONF" 2>/dev/null \
      && echo "  W policy      : active (global region in $LOGROTATE_CONF)" \
      || echo "  W policy      : not rendered yet (run: sudo w-logs apply)"
    [[ -f "$LOGROTATE_CATCHALL" ]] && echo "  catch-all     : /var/log/*.log failsafe installed" || true
  else
    echo "  logrotate     : not installed"
  fi
  echo

  echo "W's own logs (/var/log/w, tmpfiles):"
  if [[ -d "$WLOG_DIR" ]]; then
    echo "  size          : $(du -sh "$WLOG_DIR" 2>/dev/null | cut -f1)"
  fi
  [[ -f "$TMPFILES" ]] \
    && echo "  age-clean     : active ($TMPFILES)" \
    || echo "  age-clean     : not rendered yet (run: sudo w-logs apply)"
}

cmd_keep() {
  need_root
  need_conf
  local days="$1"
  [[ "$days" =~ ^[0-9]+$ && "$days" -ge 1 ]] || { err "days must be a positive integer"; exit 2; }
  set_kv RETENTION_DAYS "$days"
  render
}

cmd_limit() {
  need_root
  need_conf
  local size="$1"
  if [[ "$size" == "off" ]]; then
    set_kv MAX_SIZE ""
  else
    [[ "$size" =~ ^[0-9]+[KMG]$ ]] || { err "size must be a number plus K/M/G (e.g. 500M, 2G) or 'off'"; exit 2; }
    set_kv MAX_SIZE "$size"
  fi
  render
}

cmd_vacuum() {
  need_root
  local mode="${1:-}" value="${2:-}"
  case "$mode" in
    time) [[ "$value" =~ ^[0-9]+(s|min|h|d|w|month|y)$ ]] || { err "time span like 2w, 30d, 6month"; exit 2; } ;;
    size) [[ "$value" =~ ^[0-9]+(B|K|M|G|T)$ ]] || { err "size like 500M, 2G"; exit 2; } ;;
    *) err "vacuum mode must be 'time' or 'size'"; exit 2 ;;
  esac
  journalctl "--vacuum-$mode=$value"
}

case "${1:-}" in
  status|"")      cmd_status ;;
  keep)          [[ -n "${2:-}" ]] || { err "keep requires <days>"; usage; exit 2; }; cmd_keep "$2" ;;
  limit)         [[ -n "${2:-}" ]] || { err "limit requires <size>|off"; usage; exit 2; }; cmd_limit "$2" ;;
  vacuum)        cmd_vacuum "${2:-}" "${3:-}" ;;
  apply)         render ;;
  refresh-catchall)
                 # Cheap pre-rotation refresh (logrotate.service ExecStartPre): rebuild
                 # only the orphan-log list, no journald restart. Never fail the service.
                 need_root
                 render_logrotate_catchall || true ;;
  show)          shift
                 # A leading non-option token is treated as a unit (convenience);
                 # everything else is passed straight to journalctl (-p, -n, ...).
                 # No --no-pager here on purpose: journalctl auto-disables its pager
                 # when stdout isn't a tty, so scripted/AI callers (subprocess pipes)
                 # already get unpaged output; a human in a real terminal gets paging.
                 args=()
                 [[ -n "${1:-}" && "${1:0:1}" != "-" ]] && { args=(-u "$1"); shift; }
                 exec journalctl "${args[@]}" "$@" ;;
  help|-h|--help) usage ;;
  *)             err "unknown command: $1"; usage; exit 2 ;;
esac
