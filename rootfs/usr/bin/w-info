#!/usr/bin/env bash
# w-info — W Linux tool catalog
#
# Lists all user-facing w-* utilities with a one-line description extracted
# from each tool's `help` output (Info: line).

set -euo pipefail

BIN_DIR="${W_BIN_DIR:-/usr/bin}"

# Tools excluded from the catalog — internal / daemon / no user-facing help.
# Only names that actually sit in BIN_DIR belong here: since P9 the helpers that
# are never invoked as a command (w-authd, w-update-refresh, papirus-folders)
# live in /usr/lib/w, which this never scans, so listing them would be a rule
# protecting nothing. The four below are in /usr/bin because something calls them
# by name — a unit, an alpm hook, hyprland.lua, a Quickshell surface.
BLACKLIST=(
  w-cliphist-store
  w-mcp
  w-mkinitcpio
  w-session-exit
)

is_blacklisted() {
  local name="$1"
  local item
  for item in "${BLACKLIST[@]}"; do
    [[ "$item" == "$name" ]] && return 0
  done
  return 1
}

# W_I18N_LIB is a dev/test seam, the same one W_CONF_LIB is: it lets this CLI be
# sourced from a checkout on a machine with no W installed (scripts/check/tests).
# shellcheck source=../lib/w/w-i18n-lib.sh
source "${W_I18N_LIB:-/usr/lib/w/w-i18n-lib.sh}"

usage() {
  if w_help w-info; then return 0; fi
  cat <<EOF
Usage: w-info [help]

Info: List all W tools with a one-line description of each.

W Linux — tool catalog and system overview.

Calling without arguments lists all user-facing w-* utilities with a
short description extracted from each tool's help output.

Commands:
  help    Show this help

Exit codes:
  0  Success
  2  Usage error
EOF
}

main() {
  case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
    "")             ;;
    *)              echo "w-info: unknown command: $1" >&2; usage >&2; exit 2 ;;
  esac

  local total=0
  local entries=()

  for script in "$BIN_DIR"/w-*; do
    [[ -f "$script" ]] || continue

    local name
    name=$(basename "$script")

    is_blacklisted "$name" && continue

    # Read the Info: line straight from a FILE — never by executing the tool:
    # parsing is faster, has no side effects and needs no runtime deps, and a
    # missing Info: line self-excludes the tool. Which file depends on the
    # language: a translated help carries its own `Info:` (the marker itself is
    # never translated, w-i18n-gen asserts it), and the English original lives
    # in the tool's own usage() heredoc. Per-tool fallback, not per-catalog — a
    # tool a translation has not reached yet shows its English line rather than
    # dropping out of the list.
    local info src
    src="$(w_help_file "$name")" || src="$script"
    info=$(sed -n 's/^Info: //p' "$src" | head -1) || true

    [[ -z "$info" ]] && continue

    entries+=("$(printf '  %-22s %s' "$name" "$info")")
    total=$((total + 1))
  done

  if ((total == 0)); then
    w_t info.none >&2; echo >&2
    w_t info.hint >&2; echo >&2
    exit 1
  fi

  # The catalog's frame follows its contents: every line below is a translated
  # Info:, so this is the one w-* command whose terminal output is localized
  # too (i18n/scripts.json says why).
  w_t info.header; echo
  echo ""
  printf '%s\n' "${entries[@]}" | sort
  echo ""
  w_t info.count "$total"; echo
}

main "$@"
