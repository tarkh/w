#!/usr/bin/env bash
# w-ssh — W Linux SSH agent selection + per-host key selectors
#
# Two jobs, both about making an EXTERNAL key store (a password manager) a
# first-class citizen instead of a pile of dotfile edits. See w-ssh.md.
#
# ── 1. The agent slot ────────────────────────────────────────────────────────
# W's default SSH agent is gcr-ssh-agent, but a user who keeps their keys in
# Bitwarden/1Password wants that app's agent instead. The naive swap — export
# SSH_AUTH_SOCK from ~/.zshrc — is what everyone ends up doing and it is wrong in
# two ways: only interactive shells see it (a GUI git client launched from the
# launcher does not), and switching agents means editing dotfiles and logging out.
#
# So the session always exports ONE stable path,
#
#     SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/w/ssh-agent.sock
#
# (env-hyprland, so every process in the session inherits it), and that path is a
# SYMLINK this script re-points at whichever backend is active. Switching agents
# is then `w-ssh use <name>` and takes effect for anything started afterwards —
# no relogin, no dotfile, no per-app configuration, and no vendor name anywhere
# except one catalog line in ssh.conf.
#
# ── 2. Per-host key selectors ────────────────────────────────────────────────
# An agent holding a whole vault offers every key it has, in its own order, while
# sshd gives up after MaxAuthTries (6 by default): with more keys than that, the
# right one is never reached and the connection dies as "Too many authentication
# failures". This is not a W problem and not a Bitwarden bug either — it is how
# the agent protocol works, and the only fix in the protocol is to tell ssh WHICH
# key to ask for, per host, via `IdentityFile <public key>` + `IdentitiesOnly yes`
# (a public key on disk is not a duplicated secret: it is a selector).
#
# `w-ssh sync` builds exactly that from the agent itself. The key's comment — the
# item name in the vault — is read as the list of hosts it belongs to, so naming
# a vault item "GitLab git.example.com" is the whole configuration; there is no
# second place to maintain. Output goes to ~/.ssh/config.d/50-w-agent.conf and
# ~/.ssh/agent-keys/, never into ~/.ssh/config: that file is the user's, and a
# generator that rewrites it would eventually eat something hand-written.
#
# Exit codes: 0 success · 1 runtime error · 2 usage error

set -euo pipefail

# shellcheck source=../lib/w/w-conf-lib.sh
source /usr/lib/w/w-conf-lib.sh
wconf_load ssh

err()  { echo "w-ssh: $*" >&2; }
note() { echo "w-ssh: $*"; }

# The stable path the session exports. Deliberately under the same $XDG_RUNTIME_DIR/w
# directory w-authd uses: runtime state W owns, wiped with the session.
runtime_dir() { printf '%s/w' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }
link_path()   { printf '%s/ssh-agent.sock' "$(runtime_dir)"; }

SSH_DIR="$HOME/.ssh"
CONF_D="$SSH_DIR/config.d"
GEN="$CONF_D/50-w-agent.conf"
KEYS_DIR="$SSH_DIR/agent-keys"
USER_CONFIG="$SSH_DIR/config"
INCLUDE_LINE="Include config.d/*.conf"

usage() {
  cat <<EOF
Usage: w-ssh <command>

Info: Choose the session's SSH agent and generate per-host key selectors from it.

Commands:
  status            Active agent, socket state, generated selectors
  list              List known agent backends (* = active)
  use <name>        Switch the SSH agent (see list; 'none' = no agent)
  link              Re-point the stable socket at the active backend (login hook)
  sync              Regenerate per-host key selectors from the agent's keys
  include           Add the config.d Include line to $USER_CONFIG
  help              Show this help

Catalog & selection: layered ssh.conf (origin: w-conf cat ssh)
Generated (do NOT edit): $GEN + $KEYS_DIR/

Exit codes:
  0  Success   1  Runtime error   2  Usage error

Examples:
  w-ssh use bitwarden
  w-ssh sync
  w-ssh status
EOF
}

# ── backend catalog ───────────────────────────────────────────────────────────
active_agent() { wconf_get ssh AGENT gcr; }

# Expand the systemd-style specifiers the catalog uses. Kept to the two that can
# honestly differ per session; anything else would invite a template language.
expand_socket() { # <raw path>
  local p="$1"
  p="${p//%t/${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}"
  p="${p//%h/$HOME}"
  printf '%s\n' "$p"
}

socket_for() { # <backend> → path, or empty when unknown
  local raw; raw="$(wconf_get ssh "SOCKET_$1" "")"
  [[ -n "$raw" ]] || return 0
  expand_socket "$raw"
}

known_backends() { wconf_keys ssh SOCKET_ | sed 's/^SOCKET_//'; }

is_known() { # <name>
  local b
  while IFS= read -r b; do [[ "$b" == "$1" ]] && return 0; done < <(known_backends)
  return 1
}

# ── the stable socket link ────────────────────────────────────────────────────
# `ln -sfn` and not "remove then create": the window between the two is exactly
# when a connecting ssh finds nothing. A dangling link (agent app not started yet)
# is fine and self-healing — ssh reports the same "no agent" it would anyway, and
# the link starts working the moment the app creates its socket.
cmd_link() {
  local agent target link; agent="$(active_agent)"; link="$(link_path)"
  install -d -m700 "$(runtime_dir)"
  if [[ "$agent" == none ]]; then
    rm -f "$link"
    return 0
  fi
  target="$(socket_for "$agent")"
  if [[ -z "$target" ]]; then
    err "no socket known for agent '$agent' (see: w-ssh list)"
    return 1
  fi
  ln -sfn "$target" "$link"
}

# gcr-ssh-agent's socket unit exports SSH_AUTH_SOCK itself (ExecStartPost). Left
# running beside another agent it would keep re-announcing its own path into the
# systemd user environment, so the handoff has to be explicit: mask it while
# somebody else owns SSH, unmask when gcr is chosen again. A user-level mask
# (~/.config/systemd/user) overrides the machine-wide `--global enable`, so this
# stays a per-user decision and never touches anyone else's session.
#
# The mask is written as the SYMLINK ITSELF rather than through `systemctl --user`
# because this has to work in three contexts, and only one of them has a live user
# manager to talk to: the user's own session (it does), firstboot with root setting
# an account up before it has ever logged in (it does not), and a bundle install
# driven by root for another account (it does not, and `systemctl --user` there
# would silently address ROOT's manager instead — runuser carries root's
# XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS through). The symlink to /dev/null IS
# what a mask is on disk, so writing it is exact, not an approximation; systemctl
# is then asked — best effort — to notice, which is all it adds over the file.
sync_gcr_unit() { # <agent>
  local unit="gcr-ssh-agent.socket"
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local mask="$dir/$unit"
  if [[ "$1" == gcr ]]; then
    # Only remove OUR mask: a real unit file a user dropped there is theirs.
    [[ -L "$mask" && "$(readlink "$mask")" == /dev/null ]] && rm -f "$mask"
  else
    install -d -m755 "$dir"
    ln -sfn /dev/null "$mask"
  fi
  command -v systemctl >/dev/null 2>&1 || return 0
  [[ -d /run/systemd/system ]] || return 0
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  if [[ "$1" == gcr ]]; then
    systemctl --user start "$unit" >/dev/null 2>&1 || true
  else
    systemctl --user stop  "$unit" >/dev/null 2>&1 || true
  fi
  return 0
}

cmd_use() { # <name>
  local name="$1"
  if [[ "$name" != none ]] && ! is_known "$name"; then
    err "unknown agent '$name' (see: w-ssh list)"; exit 1
  fi
  wconf_set ssh AGENT "$name" user
  sync_gcr_unit "$name"
  cmd_link
  if [[ "$name" == none ]]; then
    note "SSH agent disabled (no socket link)"
  else
    note "SSH agent → $name ($(socket_for "$name"))"
    note "Takes effect for processes started from now on; running ones keep the old socket."
  fi
}

cmd_list() {
  local b active; active="$(active_agent)"
  echo "Known SSH agent backends (* = active):"
  while IFS= read -r b; do
    [[ "$b" == "$active" ]] && printf '  * %-12s %s\n' "$b" "$(socket_for "$b")" \
                            || printf '    %-12s %s\n' "$b" "$(socket_for "$b")"
  done < <(known_backends)
  [[ "$active" == none ]] && echo "  * none         (no agent)"
  return 0
}

# ── per-host key selectors ────────────────────────────────────────────────────
# Ask the agent through OUR link, not through whatever SSH_AUTH_SOCK the caller
# happens to carry: `w-ssh sync` must describe the agent W is pointing at, or it
# would silently generate selectors for a different vault (a real hazard right
# after `w-ssh use`, when the invoking shell still holds the previous path).
agent_keys() { SSH_AUTH_SOCK="$(link_path)" ssh-add -L 2>/dev/null; }

# One vault item name → one filesystem-safe basename. Anything outside a
# conservative set becomes '_', so a key named with a slash or a quote cannot
# steer the write out of $KEYS_DIR.
safe_name() { # <comment>
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g; s/^_*//; s/_*$//'
}

cmd_sync() {
  local link; link="$(link_path)"
  [[ -S "$link" ]] || err "no agent socket at $link — is the agent app running? (w-ssh status)"

  local keys; keys="$(agent_keys || true)"
  if [[ -z "$keys" ]]; then
    err "the agent listed no keys (locked vault, or no agent) — nothing to generate"
    exit 1
  fi

  install -d -m700 "$SSH_DIR" "$CONF_D" "$KEYS_DIR"

  local tmp kept=() body="" n=0 skipped=0
  declare -A seen_host=()
  tmp="$(mktemp "$CONF_D/.w-agent.XXXXXX")"

  local key type comment base file host hosts tok
  while read -r key type comment; do
    [[ -n "$comment" ]] || { skipped=$((skipped + 1)); continue; }

    # The item name is the host list: whitespace-separated patterns, exactly as
    # ssh_config's own `Host` takes them (a name like "GitLab git.example.com"
    # matches both the short alias and the real hostname).
    hosts=""
    for tok in $comment; do
      # A wildcard from a vault name would silently become machine-wide policy —
      # `Host *` with IdentitiesOnly pins ONE key for every destination. Never
      # generate one; the item stays usable, it just gets no selector.
      case "$tok" in *[\*\?\!]*) continue ;; esac
      hosts+="${hosts:+ }$tok"
    done
    [[ -n "$hosts" ]] || { skipped=$((skipped + 1)); continue; }

    base="$(safe_name "$comment")"
    [[ -n "$base" ]] || { skipped=$((skipped + 1)); continue; }
    file="$KEYS_DIR/$base.pub"
    printf '%s %s %s\n' "$key" "$type" "$comment" > "$file"
    chmod 644 "$file"
    kept+=("$base.pub")

    # ssh takes the FIRST value it sees for a host, so a pattern claimed twice
    # means the later key is dead weight. Say so rather than emitting a block
    # that quietly never applies.
    for tok in $hosts; do
      if [[ -n "${seen_host[$tok]:-}" ]]; then
        err "warning: host '$tok' claimed by both '${seen_host[$tok]}' and '$comment' — the first wins"
      else
        seen_host[$tok]="$comment"
      fi
    done

    body+="$(printf 'Host %s\n    IdentityFile %s\n    IdentitiesOnly yes\n' "$hosts" "$file")"$'\n\n'
    n=$((n + 1))
  done <<< "$keys"

  {
    cat <<EOF
# 50-w-agent.conf — GENERATED by \`w-ssh sync\`. Do NOT edit: the next sync
# overwrites this file wholesale. Hand-written SSH configuration belongs in
# $USER_CONFIG, which w-ssh never touches.
#
# Why these blocks exist: the agent offers every key in the vault, sshd gives up
# after MaxAuthTries (6), so without a per-host selector any key past the sixth is
# unreachable ("Too many authentication failures"). IdentityFile names the public
# half — a selector, not a secret — and IdentitiesOnly stops the rest being tried.
#
# Host patterns come from each key's name in the vault: name an item
# "Alias host.example.com 10.0.0.5" and all three match. Re-run \`w-ssh sync\`
# after adding or renaming a key.
EOF
    printf '\n%s' "$body"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$GEN"

  # Prune selectors for keys that left the vault: a stale .pub still matches its
  # Host block for as long as it exists, so leaving it behind would keep pointing
  # ssh at a key the agent can no longer sign with.
  local f b dropped=0
  for f in "$KEYS_DIR"/*.pub; do
    [[ -e "$f" ]] || continue
    b="${f##*/}"
    local found=0 k
    for k in "${kept[@]}"; do [[ "$k" == "$b" ]] && { found=1; break; }; done
    [[ $found -eq 1 ]] || { rm -f "$f"; dropped=$((dropped + 1)); }
  done

  note "generated $n host selector(s) in $GEN$([[ $dropped -gt 0 ]] && echo ", pruned $dropped stale key(s)")"
  [[ $skipped -gt 0 ]] && note "skipped $skipped key(s) with no usable host in the name"
  case "$(include_state)" in
    1) note "NOTE: $USER_CONFIG does not include the generated file yet — run: w-ssh include" ;;
    2) err "WARNING: the Include in $USER_CONFIG sits inside a Host block — these selectors"
       err "are being parsed but applied to one host only. Run 'w-ssh include' for details." ;;
  esac
  return 0
}

# Where the Include sits, which is NOT a cosmetic question:
#
#   0  present in the global section — works
#   1  absent
#   2  present but AFTER a Host/Match line, i.e. INSIDE that block
#
# State 2 is the trap this function exists for. A Host block in ssh_config runs to
# the next Host/Match keyword — a blank line does not close it — so an Include
# appended to the end of a config that has any stanzas is swallowed by the last
# one and only takes effect for that host. Nothing warns: ssh reads the file, says
# so with -vvv, and applies none of it. Cost me one such file to notice.
include_state() {
  [[ -f "$USER_CONFIG" ]] || { echo 1; return 0; }
  awk '
    {
      line = $0; sub(/^[ \t]+/, "", line); low = tolower(line)
      if (low ~ /^include[ \t]+/ && low ~ /config\.d\//) { print (inblock ? 2 : 0); found = 1; exit }
      if (low ~ /^host[ \t]+/ || low ~ /^match[ \t]+/) inblock = 1
    }
    END { if (!found) print 1 }
  ' "$USER_CONFIG"
}

has_include() { [[ "$(include_state)" == 0 ]]; }

cmd_include() {
  install -d -m700 "$SSH_DIR"
  local state; state="$(include_state)"
  case "$state" in
    0) note "$USER_CONFIG already includes config.d — nothing to do"; return 0 ;;
    2) err "$USER_CONFIG has an Include for config.d, but it sits inside a Host/Match block"
       err "so it applies to that host only. Move the '$INCLUDE_LINE' line above the first"
       err "Host/Match line. Not doing it here: that file is yours to edit."
       return 1 ;;
  esac
  if [[ -f "$USER_CONFIG" ]]; then
    cp -p "$USER_CONFIG" "$USER_CONFIG.bak"
    note "backed up $USER_CONFIG → $USER_CONFIG.bak"
  fi
  # PREPENDED: the global section is the only place an Include applies to every
  # host (see include_state). The usual worry about going first — "generated
  # settings would shadow my own" — does not arise here, because these blocks set
  # exactly two options and neither shadows: IdentityFile ACCUMULATES across
  # matching blocks, so a hand-written key for the same host is still offered
  # alongside ours, and IdentitiesOnly only narrows the list to those two.
  local tmp; tmp="$(mktemp "$SSH_DIR/.w-ssh.XXXXXX")"
  {
    printf '# W Linux — per-host key selectors generated from the SSH agent by `w-ssh sync`.\n'
    printf '# Must stay ABOVE the first Host/Match line: an Include below one belongs to\n'
    printf '# that block and would apply to a single host instead of all of them.\n'
    printf '%s\n\n' "$INCLUDE_LINE"
    [[ -f "$USER_CONFIG" ]] && cat "$USER_CONFIG"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$USER_CONFIG"
  note "added '$INCLUDE_LINE' at the top of $USER_CONFIG"
}

cmd_status() {
  local agent link target; agent="$(active_agent)"; link="$(link_path)"
  echo "Agent     : $agent  (layered config; per-value origin: w-conf cat ssh)"
  if [[ "$agent" != none ]]; then
    target="$(socket_for "$agent")"
    echo "Socket    : ${target:-<unknown>}"
    if [[ -S "$target" ]]; then echo "            listening"
    else echo "            NOT present — the agent app is probably not running"; fi
  fi
  if [[ -L "$link" ]]; then
    echo "Link      : $link → $(readlink "$link")"
  else
    echo "Link      : $link (absent — run: w-ssh link)"
  fi
  # The variable is inherited at process start, so a shell opened before the last
  # `w-ssh use` still carries the old value. Naming that explicitly saves the
  # "I switched agents and nothing changed" debugging session.
  if [[ "${SSH_AUTH_SOCK:-}" == "$link" ]]; then
    echo "SSH_AUTH_SOCK: $link (stable path — correct)"
  else
    echo "SSH_AUTH_SOCK: ${SSH_AUTH_SOCK:-<unset>}"
    echo "            ^ not W's stable path: this process was started before it was set."
  fi
  local n; n="$(agent_keys | grep -c . || true)"
  echo "Keys      : ${n:-0} offered by the agent"
  if [[ -f "$GEN" ]]; then
    echo "Selectors : $(grep -c '^Host ' "$GEN" || echo 0) host block(s) in $GEN"
  else
    echo "Selectors : none generated yet (w-ssh sync)"
  fi
  case "$(include_state)" in
    0) echo "Include   : $USER_CONFIG includes config.d (global section — active)" ;;
    1) echo "Include   : MISSING from $USER_CONFIG (w-ssh include)" ;;
    2) echo "Include   : present but INSIDE a Host block — applies to one host only (w-ssh include)" ;;
  esac
  return 0
}

case "${1:-}" in
  status)         cmd_status ;;
  list)           cmd_list ;;
  use)            [[ -n "${2:-}" ]] || { err "use requires an agent name"; usage >&2; exit 2; }
                  cmd_use "$2" ;;
  link)           cmd_link ;;
  sync)           cmd_sync ;;
  include)        cmd_include ;;
  help|-h|--help) usage ;;
  "")             usage; exit 2 ;;
  *)              err "unknown command: $1"; usage >&2; exit 2 ;;
esac
