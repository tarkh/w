#!/usr/bin/env bash
# w-time — W Linux date / time / timezone / NTP control
#
# Thin front over systemd's timedatectl (timezone, the RTC clock and the NTP
# on/off switch) and systemd-timesyncd (the NTP server set). The server catalog
# and the active selection live in /etc/w/time.conf (the source-of-truth, like
# w-dns's dns.conf); w-time renders the chosen server set into
# /etc/systemd/timesyncd.conf.d/10-w-ntp.conf (do NOT hand-edit that file) and
# restarts timesyncd. Timezone and the NTP on/off flag are live system state read
# straight from timedatectl — only the server catalog is kept in the conf.
#
# The hardware clock (RTC) is the exception: its mode is a conf key, RTC=auto|utc|
# local, applied by `apply`. Windows keeps the RTC in local time and W never writes
# into Windows, so `auto` follows it — local time while this machine's firmware has
# a Windows boot entry (w-boot-otheros, the boot menus' own detector), UTC otherwise.
# Otherwise every switch between the two moves the clock by the zone's offset.
#
# It is the privileged (root) backend for the W Hub "Date & Time" panel, reached
# via pkexec + the com.w.hub.actuate polkit action (capabilities timezone-set /
# ntp-toggle / ntp-servers), and for the AI's w_timezone_set / w_ntp_set tools via
# com.w.ai.actuate. See w-time.md and w-scripts.md.

set -euo pipefail

CONF="/etc/w/time.conf"
OTHEROS="${W_OTHEROS:-/usr/lib/w/w-boot-otheros}"   # seam for the unit tests
DROPIN="/etc/systemd/timesyncd.conf.d/10-w-ntp.conf"

# shellcheck source=../lib/w/w-conf-lib.sh
source "${W_CONF_LIB:-/usr/lib/w/w-conf-lib.sh}"
# Split into layers (update-system.md phase 3): the NTP catalog and W's default
# selection live in /usr/share/w/defaults/time.conf; /etc/w/time.conf holds this
# machine's deviations, including any NTP_<name> the admin adds — catalogs MERGE
# per key, so a site-specific set coexists with the vendor ones and survives updates.
wconf_load time  # one pass up front; the $(…) reads below are cache hits
conf_get() { wconf_get time "$1" "${2:-}"; }

err() { echo "w-time: $*" >&2; }
die() { err "$*"; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "this command requires root"; }
need_conf() { wconf_has time SERVERS || die "no NTP configuration in any layer (vendor file missing — run: sudo apply.sh --rootfs)"; }

# W_I18N_LIB is a dev/test seam, the same one W_CONF_LIB is: it lets this CLI be
# sourced from a checkout on a machine with no W installed (scripts/check/tests).
# shellcheck source=../lib/w/w-i18n-lib.sh
source "${W_I18N_LIB:-/usr/lib/w/w-i18n-lib.sh}"

usage() {
  if w_help w-time; then return 0; fi
  cat <<EOF
Usage: w-time <command> [args]

Info: Set the timezone, the system clock and NTP (systemd-timesyncd).

Commands:
  status                 Show timezone, clock, NTP state + the selected server set
  list-zones [--porcelain]
                         List timezones as "<offset>  <Zone>" (copy the Zone name)
  set-zone <Zone>        Set the timezone (root; e.g. Europe/Moscow)
  ntp on|off             Enable/disable network time sync (root)
  set-time <"Y-m-d H:M:S">
                         Set the clock manually (root; requires NTP off)
  servers <name>         Switch the NTP server set from the catalog (root)
  rtc [auto|utc|local]   Show/set the hardware clock mode (setting: root); auto =
                         local time when Windows is on this machine, else UTC
  apply                  Re-render the timesyncd drop-in from $CONF (after editing)
                         and apply the hardware clock mode
  help                   Show this help

Catalog & selection: $CONF   Rendered (generated): $DROPIN

Exit codes: 0 success · 1 runtime/validation error · 2 usage

Examples:
  w-time status
  w-time list-zones | grep -i berlin
  sudo w-time set-zone Europe/Moscow
  sudo w-time ntp off
  sudo w-time set-time "2026-07-23 14:30:00"
  sudo w-time servers cloudflare
  sudo w-time rtc utc
EOF
}

zone_valid() { [[ "$1" =~ ^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]]; }
zone_known() { timedatectl list-timezones 2>/dev/null | grep -qxF "$1"; }

# Emit "<offset>  <Zone>" for every timezone, offset as ±HH:MM for the current date.
list_zones() {
  local z off porcelain=""
  [[ "${1:-}" == "--porcelain" ]] && porcelain=1
  timedatectl list-timezones | while read -r z; do
    off="$(TZ="$z" date +%z)"                      # e.g. +0300 / -0430
    off="${off:0:3}:${off:3:2}"                    # -> +03:00
    if [[ -n "$porcelain" ]]; then printf '%s %s\n' "$off" "$z"
    else printf '  %-7s  %s\n' "$off" "$z"; fi
  done
}

# Writes land in the admin layer via the shared setter (appends an absent key —
# the admin file is empty until this machine actually deviates).
set_kv() { need_root; wconf_set time "$1" "$2"; }

render() {
  need_root
  need_conf
  local sel servers fallback
  sel="$(conf_get SERVERS)"
  servers="$(conf_get "NTP_${sel}")"
  fallback="$(conf_get FALLBACK)"
  [[ -n "$servers" ]] || die "unknown server set '${sel}' (see: $CONF)"
  install -d -m755 "$(dirname "$DROPIN")"
  cat > "$DROPIN" <<EOF
# W Linux — generated by w-time. Do NOT edit; edit $CONF then run 'w-time apply'
# (or w-time servers <name>). See w-time.md.
[Time]
NTP=$servers
FallbackNTP=$fallback
EOF
  # Apply live only under systemd (skipped in a chroot/install: the drop-in is
  # written and timesyncd picks it up on first boot). timesyncd re-reads its config
  # on restart; restart only when the unit is running (NTP on) so a switch while NTP
  # is off just stages the file.
  if [[ -d /run/systemd/system ]] && systemctl is-active --quiet systemd-timesyncd; then
    systemctl restart systemd-timesyncd
  fi
  echo "w-time: NTP server set '${sel}' -> applied"
}

# The RTC mode this machine should have: "local" | "utc".
rtc_want() {
  local m; m="$(conf_get RTC auto)"
  case "$m" in
    utc|local) echo "$m" ;;
    *) if [[ -n "$("$OTHEROS" 2>/dev/null)" ]]; then echo local; else echo utc; fi ;;
  esac
}

# Only under systemd: in a chroot (install) timedated is absent — the first boot's
# apply sets the mode before Windows can be started from W's menu. Without
# --adjust-system-clock: the system clock (NTP-synced) is right, the RTC is rewritten
# from it.
rtc_apply() {
  [[ -d /run/systemd/system ]] || return 0
  local want cur
  want="$(rtc_want)"
  cur="$(timedatectl show -p LocalRTC --value 2>/dev/null)"
  if [[ "$want" == local && "$cur" == yes || "$want" == utc && "$cur" == no ]]; then return 0; fi
  if [[ "$want" == local ]]; then timedatectl set-local-rtc 1; else timedatectl set-local-rtc 0; fi
  echo "w-time: hardware clock (RTC) -> $([[ "$want" == local ]] && echo "local time" || echo UTC)"
}

cmd_status() {
  echo "== timedatectl =="
  timedatectl
  if [[ -r "$CONF" ]]; then
    echo
    echo "NTP server set : $(conf_get SERVERS '?')"
    echo "RTC mode       : $(conf_get RTC auto) -> $(rtc_want)"
    echo "                 (layered config; per-value origin: w-conf cat time)"
  fi
}

cmd_set_zone() {
  local tz="${1:-}"; [[ -n "$tz" ]] || { err "set-zone: <Zone> required"; exit 2; }
  zone_valid "$tz" || die "invalid timezone name: $tz"
  need_root
  zone_known "$tz" || die "unknown timezone: $tz (see: w-time list-zones)"
  timedatectl set-timezone "$tz"
  echo "w-time: timezone set to $tz"
}

cmd_ntp() {
  local s="${1:-}"
  case "$s" in on) s=true ;; off) s=false ;; *) err "ntp: expected on|off"; exit 2 ;; esac
  need_root
  timedatectl set-ntp "$s"
  echo "w-time: NTP $([[ "$s" == true ]] && echo enabled || echo disabled)"
}

cmd_set_time() {
  local t="${1:-}"; [[ -n "$t" ]] || { err "set-time: <\"Y-m-d H:M:S\"> required"; exit 2; }
  need_root
  # timedatectl refuses to set the clock while NTP is on; surface a clear hint.
  if timedatectl show -p NTP --value 2>/dev/null | grep -qx yes; then
    die "NTP is on — run 'sudo w-time ntp off' first, then set the time"
  fi
  timedatectl set-time "$t"
  echo "w-time: clock set to $t"
}

cmd_servers() {
  local name="${1:-}"; [[ -n "$name" ]] || { err "servers: <name> required"; exit 2; }
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid server-set name: $name"
  need_root
  need_conf
  [[ -n "$(conf_get "NTP_${name}")" ]] || die "unknown server set '$name' (see: $CONF)"
  set_kv SERVERS "$name"
  render
}

cmd_rtc() {
  local m="${1:-}"
  case "$m" in
    "") echo "$(conf_get RTC auto) -> $(rtc_want)"; return ;;
    auto|utc|local) ;;
    *) err "rtc: expected auto|utc|local"; exit 2 ;;
  esac
  need_root
  set_kv RTC "$m"
  rtc_apply
}

case "${1:-}" in
  status)         cmd_status ;;
  list-zones)     shift; list_zones "${1:-}" ;;
  set-zone)       shift; cmd_set_zone "$@" ;;
  ntp)            shift; cmd_ntp "$@" ;;
  set-time)       shift; cmd_set_time "$@" ;;
  servers)        shift; cmd_servers "$@" ;;
  rtc)            shift; cmd_rtc "$@" ;;
  apply)          render; rtc_apply ;;
  help|-h|--help) usage ;;
  "")             usage; exit 2 ;;
  *)              err "unknown command: $1"; usage; exit 2 ;;
esac
