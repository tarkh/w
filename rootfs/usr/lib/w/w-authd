def sock_path():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    d = os.path.join(base, "w")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "authd.sock")


class Fingerprint:
    """Will PAM actually try a fingerprint for this identity?

    /etc/pam.d/polkit-1 opens with `auth sufficient pam_fprintd.so`, which is a
    silent no-op when there is no reader or the identity enrolled no finger: PAM
    goes straight to the password request. The card has to know WHICH of the two
    will happen at `begin` time — a card that opens with a password field and then
    swaps itself for a fingerprint prompt (or the reverse) flickers on every single
    polkit action, which is worse than either mode alone.

    fprintd answers both halves over D-Bus and needs no polkit prompt to do it:
    ListEnrolledFingers is gated by net.reactivated.fprint.device.verify, whose
    shipped default is allow_active=yes (verified on real hardware — `fprintd-list`
    from a session raises no dialog).

    Everything here is ASYNC and cached. A prompt must never wait on fprintd:
    the D-Bus name is activatable, so a cold call can take a moment, and the
    password path — by far the common one — may not pay for that. The cache is
    consulted synchronously, seeded at daemon start for our own uid (login happens
    long before the first prompt) and refreshed in the background when stale. An
    answer that is missing or out of date therefore costs only the OLD behaviour:
    a password card, which a successful swipe still closes on its own.

    It also answers the OTHER half — is the reader free right now? — from fprintd's
    `finger-needed` property, which is true exactly while some client is waiting for
    a finger and emits PropertiesChanged, so no polling and no timers are involved.
    A busy reader means someone else's verification owns the device (a lock screen,
    or a conversation this daemon has abandoned), and PAM's fingerprint step will
    fail its Claim within the blink of an eye — so the card opens as a password card
    instead of telling the user to touch a device that cannot answer them.
    """

    BUS_NAME = "net.reactivated.Fprint"
    MANAGER_PATH = "/net/reactivated/Fprint/Manager"
    IFACE_MANAGER = "net.reactivated.Fprint.Manager"
    IFACE_DEVICE = "net.reactivated.Fprint.Device"
    IFACE_PROPS = "org.freedesktop.DBus.Properties"
    TIMEOUT_MS = 3000
    # The lamp repair (see _lamp_off): who to run, and how long to let the capture
    # live before the process is killed. Long enough for fprintd to have claimed the
    # device and started the verification, short enough that a prompt raised right
    # after a cancel does not find the reader busy.
    VERIFY_BIN = "/usr/bin/fprintd-verify"
    LAMP_MS = 500
    TTL_US = 30 * 1000 * 1000     # re-probe at most every 30s (enrolment is rare)

    def __init__(self):
        self.bus = None
        self.device = None            # object path of the default reader, "" = none
        self.in_use = False           # somebody is waiting for a finger right now
        self._enrolled = {}           # uid -> bool
        self._stamp = {}              # uid -> monotonic microseconds of last answer
        self._busy = set()            # uids with a probe in flight
        self._props_sub = None        # PropertiesChanged subscription for the device
        self._lamp_pending = False    # abort() ran: put the reader's lamp out on return
        Gio.bus_get(Gio.BusType.SYSTEM, None, self._on_bus, None)

    # ── sync surface (what a prompt calls) ───────────────────────────────────
    def enrolled(self, uid):
        """Last known answer for uid, refreshing in the background when stale."""
        if uid is None:
            return False
        age = GLib.get_monotonic_time() - self._stamp.get(uid, 0)
        if age > self.TTL_US:
            self.refresh(uid)
        return self._enrolled.get(uid, False)

    def refresh(self, uid):
        if uid is None or uid in self._busy:
            return
        # ⚠️ OUR OWN uid ONLY. fprintd gates any request naming a DIFFERENT user
        # behind net.reactivated.fprint.device.setusername, whose default is
        # auth_admin_keep — so probing another identity would make polkitd raise a
        # second authentication, i.e. this daemon prompting itself, recursively,
        # from inside the handler of the first prompt. The case that would reach it
        # is an auth_admin action on a non-admin's session (identity = some other
        # administrator); there we simply report False and the card opens in
        # password mode, which is exactly what it did before fingerprint mode
        # existed. Nothing is lost: a successful swipe still closes that card.
        if uid != os.getuid():
            self._settle(uid, False)
            return
        try:
            name = pwd.getpwuid(uid).pw_name
        except KeyError:
            return
        self._busy.add(uid)
        if self.bus is None:          # bus_get still in flight; _on_bus will retry
            return
        if self.device is None:
            self._get_device(uid, name)
        else:
            self._list_fingers(uid, name)

    # ── async plumbing ───────────────────────────────────────────────────────
    def _settle(self, uid, value):
        self._enrolled[uid] = value
        self._stamp[uid] = GLib.get_monotonic_time()
        self._busy.discard(uid)

    def _on_bus(self, _src, res, _data):
        try:
            self.bus = Gio.bus_get_finish(res)
        except GLib.Error:
            self.bus = None
            for uid in list(self._busy):
                self._settle(uid, False)
            return
        self._watch_owner()
        for uid in list(self._busy):  # anything that asked before the bus was up
            self._busy.discard(uid)
            self.refresh(uid)

    def _watch_owner(self):
        # fprintd coming and going is our business twice over: while it is away
        # nothing can be verifying (so `in_use` must not stay stuck true), and its
        # RETURN after abort() is the moment to put the lamp out — see _lamp_off.
        self.bus.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", self.BUS_NAME, Gio.DBusSignalFlags.NONE,
            self._on_owner, None,
        )

    def _on_owner(self, _conn, _sender, _path, _iface, _signal, params, _data):
        new_owner = params.unpack()[2]
        if not new_owner:
            self.in_use = False
            return
        if self._lamp_pending:
            self._lamp_pending = False
            self._lamp_off()

    def _call(self, path, iface, method, args, done, uid, name):
        self.bus.call(
            self.BUS_NAME, path, iface, method, args, None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, done, (uid, name),
        )

    def _get_device(self, uid, name):
        def done(bus, res, data):
            u, n = data
            try:
                self.device = bus.call_finish(res).unpack()[0]
            except GLib.Error:
                # No fprintd, no reader, or it refused us: no fingerprint step.
                self.device = None
                self.in_use = False
                self._settle(u, False)
                return
            self._watch_in_use()
            self._list_fingers(u, n)
        self._call(self.MANAGER_PATH, self.IFACE_MANAGER, "GetDefaultDevice",
                   None, done, uid, name)

    # ── "is the reader free?" ────────────────────────────────────────────────
    def _watch_in_use(self):
        # Subscribed once per resolved device; fprintd emits PropertiesChanged for
        # finger-needed, so the answer stays current for free. The subscription is
        # by well-known name, so it survives fprintd being restarted (which is a
        # thing this daemon does on purpose — see abort()).
        if self.bus is None or self.device is None or self._props_sub is not None:
            return
        self._props_sub = self.bus.signal_subscribe(
            self.BUS_NAME, self.IFACE_PROPS, "PropertiesChanged", self.device,
            self.IFACE_DEVICE, Gio.DBusSignalFlags.NONE, self._on_props, None,
        )

    def _on_props(self, _conn, _sender, _path, _iface, _signal, params, _data):
        changed = params.unpack()[1]
        if "finger-needed" in changed:
            self.in_use = bool(changed["finger-needed"])

    def _read_in_use(self):
        # Belt to the signal's braces: re-read on every cache refresh, so a missed
        # emission (or a restarted fprintd) cannot pin the answer to a stale value.
        def done(bus, res, _data):
            try:
                self.in_use = bool(bus.call_finish(res).unpack()[0])
            except GLib.Error:
                self.in_use = False
        self.bus.call(
            self.BUS_NAME, self.device, self.IFACE_PROPS, "Get",
            GLib.Variant("(ss)", (self.IFACE_DEVICE, "finger-needed")), None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, done, None,
        )

    def abort(self):
        """End the fingerprint attempt PAM is blocked on — now, not in 30 seconds.

        ⚠️ Nothing else can do this. Since polkit 126 the PAM conversation runs in
        polkit-agent-helper@.service, a socket-activated ROOT unit: there is no
        child process for PolkitAgent.Session.cancel() to signal, and pam_fprintd
        sits inside it owning the reader until its own timeout expires. Measured on
        real hardware: the card closed in 1 ms, the sensor stayed lit for another
        27 s, and every prompt raised in the meantime had to fall back to a password
        because the device was still claimed.

        The one abort path the module itself honours is fprintd leaving the bus: its
        NameOwnerChanged handler returns PAM_AUTHINFO_UNAVAIL at once and WITHOUT
        spending one of max-tries, so PAM simply carries on to the password. Hence
        the restart. Measured: reader released and the password request delivered
        83 ms later.

        Called ONLY while our own conversation is the one holding the reader
        (AuthRequest.fp_stage), so a lock screen's verification is never collateral.
        The call is deliberately NON-interactive: if 50-w-fprintd-abort.rules is
        missing, polkitd refuses instead of asking this daemon to authenticate from
        inside its own prompt handler, and the reader just runs its timeout out.
        """
        if self.bus is None or not self.in_use:
            return
        self.in_use = False
        self._lamp_pending = True

        def done(bus, res, _d):
            try:
                bus.call_finish(res)
            except GLib.Error:
                # Refused (no rule) or systemd said no: the restart never happened,
                # so there is no lamp of ours to put out. Clearing the flag keeps a
                # later, unrelated fprintd restart from triggering a stray cycle.
                self._lamp_pending = False

        self.bus.call(
            "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
            "org.freedesktop.systemd1.Manager", "RestartUnit",
            GLib.Variant("(ss)", ("fprintd.service", "replace")), None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, done, None,
        )

    def _lamp_off(self):
        """Put out the reader's lamp, which the restart leaves burning.

        systemd stops fprintd with SIGTERM and fprintd exits without closing the
        device — libfprint says so out loud in the journal ("Device was not cleaned
        up properly before being finalized", then libusb's "application left some
        devices open"). On a press sensor like the uru4000 the lamp belongs to the
        CAPTURE state machine, not to the device handle, so it stays lit.

        ⚠️ Two obvious repairs do NOT work, both tried on real hardware:
          • Claim+Release (a plain open/close) — the lamp is untouched by it;
          • Claim+VerifyStart+VerifyStop+Release — the lamp stayed lit AND fprintd
            was left believing the device was still claimed, which is worse than
            the symptom.
        What does work, by hand, is `fprintd-verify` interrupted with Ctrl+C. The
        reason is not that the tool exits politely — it installs no signal handler
        at all (no sigaction, no g_unix_signal_add in the binary), so the client is
        simply killed mid-verification. The cleanup that clears the lamp is
        fprintd's OWN client-vanished path, the same one measured at 59 ms in the
        very first experiment of this feature.

        So the repair is to reproduce a client that dies mid-verification. It is
        done with a REAL short-lived process — `fprintd-verify`, the very tool the
        recipe was found with — rather than with a throwaway D-Bus connection of our
        own, because that was tried too and is worse: GDBus's close() did not make
        fprintd consider the client gone, so the reader stayed CLAIMED, which breaks
        the fingerprint outright instead of merely leaving a lamp on. A process
        exiting is unambiguous to everyone; a connection object's lifetime is not.

        Killing it is not impolite, it is the mechanism: SIGKILL, since there is no
        handler to run and nothing to wind down. The claim dies with the process
        (fprintd drops it on the client vanishing — 59 ms, measured), so this cannot
        strand the reader even if the kill or the reap goes wrong.

        Driven off NameOwnerChanged rather than a timer: this has to land on the NEW
        fprintd, and its arrival on the bus is the only honest signal that it is
        there.
        """
        try:
            name = pwd.getpwuid(os.getuid()).pw_name
        except KeyError:
            return
        if not os.access(self.VERIFY_BIN, os.X_OK):
            return
        try:
            pid, _i, _o, _e = GLib.spawn_async(
                [self.VERIFY_BIN, name],
                flags=GLib.SpawnFlags.DO_NOT_REAP_CHILD
                | GLib.SpawnFlags.STDOUT_TO_DEV_NULL
                | GLib.SpawnFlags.STDERR_TO_DEV_NULL,
            )
        except GLib.Error:
            return
        # ⚠️ NEVER signal this pid once it has been reaped. `fprintd-verify` can exit
        # on its own well before the timer (the reader may still be settling after
        # the restart and refuse the claim); the child watch reaps it, the kernel is
        # then free to hand that number to somebody else, and a late SIGKILL lands on
        # a stranger. That is not theoretical — it killed the whole Quickshell shell
        # once. Until the reap the pid is either alive or a zombie, and both are safe
        # to signal, so the reaped flag is the entire guard. Both callbacks run in
        # this one main loop, so there is no window between the test and the kill.
        live = {"pid": pid}

        def reaped(p, _status):
            live.pop("pid", None)
            GLib.spawn_close_pid(p)

        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, reaped)

        def kill_it():
            # The capture has had its moment; going away now is what clears the lamp.
            if "pid" in live:
                try:
                    os.kill(live["pid"], signal.SIGKILL)
                except OSError:
                    pass
            return GLib.SOURCE_REMOVE

        GLib.timeout_add(self.LAMP_MS, kill_it)

    # ── the "skip the reader this time" flag ─────────────────────────────────
    # Read by /usr/lib/w/w-fp-gate, the pam_exec module that fronts pam_fprintd in
    # /etc/pam.d/polkit-1. Why a file and not something in-process: the decision has
    # to reach the PAM conversation, which runs in a separate process we do not
    # control the environment of.
    #
    # ⚠️ NOT in $XDG_RUNTIME_DIR, however obvious that looks. The conversation runs
    # in polkit-agent-helper@.service, hardened with ProtectHome=yes — which hides
    # /home, /root AND /run/user. A flag under our own runtime dir is invisible from
    # in there, which is exactly how this mechanism managed to ship doing nothing at
    # all. /run/w/fp is outside that mask; tmpfiles.d/w.conf creates it sticky (1777)
    # so each user may drop their own flag and remove nobody else's, and the gate
    # ignores a flag not owned by the account being authenticated.
    SKIP_DIR = "/run/w/fp"

    @classmethod
    def _skip_path(cls):
        return os.path.join(cls.SKIP_DIR, f"fp-skip-{os.getuid()}")

    @classmethod
    def set_skip(cls, on):
        p = cls._skip_path()
        try:
            if on:
                with open(p, "w"):
                    pass
            else:
                os.unlink(p)
        except OSError:
            # Best effort by design: failing to SET it costs the old behaviour (the
            # user waits out the reader), and failing to CLEAR it is repaired by the
            # next daemon start, which clears unconditionally. A missing directory
            # (tmpfiles never ran) lands on the same safe side.
            pass

    def _list_fingers(self, uid, name):
        self._read_in_use()

        def done(bus, res, data):
            u, _n = data
            try:
                fingers = bus.call_finish(res).unpack()[0]
            except GLib.Error:
                # NoEnrolledPrints is an ERROR here, not an empty list — and a
                # device that vanished (unplugged reader) must invalidate the
                # cached path so the next probe re-resolves it, subscription
                # included: it is bound to that object path.
                if self._props_sub is not None:
                    self.bus.signal_unsubscribe(self._props_sub)
                    self._props_sub = None
                self.device = None
                self.in_use = False
                self._settle(u, False)
                return
            self._settle(u, bool(fingers))
        self._call(self.device, self.IFACE_DEVICE, "ListEnrolledFingers",
                   GLib.Variant("(s)", (name,)), done, uid, name)


class AuthUI:
    """Owns the unix socket to the shell and routes messages to/from requests."""

    def __init__(self, path):
        self.path = path
        self.clients = []          # list of {out, in} for connected shells
        self.requests = {}         # id -> the ONE active AuthRequest (shell-visible)
        self.queue = []            # AuthRequests awaiting their turn (FIFO)
        self.active = None         # the request currently shown to the user
        self.fp = Fingerprint()    # shared cache: does PAM have a finger to try?
        self._seq = 0

    def next_id(self):
        self._seq += 1
        return self._seq

    # One prompt on screen at a time (like GNOME/KDE): concurrent BeginAuthentication
    # calls queue up and are shown in arrival order. The shell stays simple (single
    # curId); it never has to juggle stacked prompts.
    def enqueue(self, req):
        self.queue.append(req)
        self._pump()

    def _pump(self):
        if self.active is None and self.queue:
            self.active = self.queue.pop(0)
            self.requests[self.active.id] = self.active
            self.active.start()

    def finish(self, req):
        self.requests.pop(req.id, None)
        if req in self.queue:          # finished while still queued (cancelled early)
            self.queue.remove(req)
        if self.active is req:
            self.active = None
            self._pump()               # promote the next waiting prompt

    def start(self):
        try:
            os.unlink(self.path)
        except FileNotFoundError:
            pass
        self.service = Gio.SocketService.new()
        addr = Gio.UnixSocketAddress.new(self.path)
        self.service.add_address(
            addr, Gio.SocketType.STREAM, Gio.SocketProtocol.DEFAULT, None
        )
        os.chmod(self.path, 0o600)
        self.service.connect("incoming", self._on_incoming)
        self.service.start()

    def _on_incoming(self, service, conn, src):
        client = {
            "conn": conn,
            "out": conn.get_output_stream(),
            "in": Gio.DataInputStream.new(conn.get_input_stream()),
        }
        self.clients.append(client)
        # A shell that connected mid-prompt (e.g. after a restart) still sees it.
        for req in self.requests.values():
            self._send_one(client, req.begin_msg())
        self._read_line(client)
        return False

    def _read_line(self, client):
        client["in"].read_line_async(
            GLib.PRIORITY_DEFAULT, None, self._on_line, client
        )

    def _on_line(self, istream, res, client):
        try:
            line, _ = istream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if not line:
            self._drop(client)
            return
        self._handle(line)
        self._read_line(client)

    def _drop(self, client):
        if client in self.clients:
            self.clients.remove(client)

    def _handle(self, line):
        try:
            msg = json.loads(line)
        except (ValueError, TypeError):
            return
        req = self.requests.get(msg.get("id"))
        if not req:
            return
        t = msg.get("type")
        if t == "response":
            req.submit(msg.get("password", ""), bool(msg.get("choice", False)))
        elif t == "select":
            # Only polkit requests offer a choice of identity; gcr ones have none.
            if hasattr(req, "select_identity"):
                req.select_identity(msg.get("user", ""))
        elif t == "skipfp":
            # Only polkit requests ever run PAM, so only they have a reader to skip.
            if hasattr(req, "skip_fingerprint"):
                req.skip_fingerprint()
        elif t == "cancel":
            req.cancel()

    def send(self, obj):
        data = (json.dumps(obj) + "\n").encode()
        for client in list(self.clients):
            self._send_bytes(client, data)

    def _send_one(self, client, obj):
        self._send_bytes(client, (json.dumps(obj) + "\n").encode())

    def _send_bytes(self, client, data):
        try:
            client["out"].write_all(data, None)
        except GLib.Error:
            self._drop(client)


class AuthRequest:
    """One polkit BeginAuthentication call: PolkitAgent.Session(s) + a shell prompt."""

    MAX_TRIES = 3

    def __init__(self, ui, agent, action_id, message, icon, cookie, identities, invocation):
        self.ui = ui
        self.agent = agent
        self.action_id = action_id or ""
        self.message = message or ""
        self.icon = icon or ""
        self.cookie = cookie
        self.invocation = invocation
        self.id = ui.next_id()
        # Every unix-user identity polkit will accept for this action, in its order,
        # plus the one we start with. On a single-user machine that is a list of one
        # (the user themselves); for an auth_admin action on a non-admin's session it
        # is every administrator of the machine — hence both the honest "whose
        # password" label and the selector below.
        self.choices = self._user_choices(identities)
        self.identity_uid, self.selectable = self._pick_identity()
        self.identity = (
            Polkit.UnixUser.new(self.identity_uid) if self.identity_uid is not None else None
        )
        self.session = None
        self.awaiting = False       # a request() is outstanding (waiting on user)
        self.pending = None         # password typed before request() arrived
        self.tries = 0
        self.saw_error = False      # PAM emitted a show-error this try (don't clobber)
        self.cancelled = False
        self.done = False
        self.fp_skipped = False     # user chose the password over the reader
        self.fp_stage = False       # OUR conversation is the one holding the reader

    @staticmethod
    def _user_choices(identities):
        # identities: list of (kind_str, {key: value}). Only unix-user ones can be
        # authenticated here (a unix-group identity names no account to prompt for),
        # so they are skipped exactly as before.
        out = []
        for kind, det in identities:
            if kind != "unix-user":
                continue
            uid = det.get("uid")
            if uid is None:
                continue
            uid = int(uid)
            try:
                name = pwd.getpwuid(uid).pw_name
            except KeyError:
                name = f"uid {uid}"
            out.append({"uid": uid, "name": name})
        return out

    def _pick_identity(self):
        # Prefer our own uid — the person at the keyboard authenticating as themselves
        # is both the common case and the only one that needs no explanation. When we
        # are NOT in the list (a non-admin triggering an auth_admin action), we still
        # have to start somewhere, but the shell then gets the full list so the user
        # can pick the administrator who is actually present instead of staring at an
        # unlabelled field and typing a password that cannot work.
        me = os.getuid()
        for c in self.choices:
            if c["uid"] == me:
                return me, False
        if not self.choices:
            return None, False
        return self.choices[0]["uid"], len(self.choices) > 1

    def _current_name(self):
        for c in self.choices:
            if c["uid"] == self.identity_uid:
                return c["name"]
        return ""

    def _fp_expected(self):
        # Asked for the identity we are about to authenticate AS, not for the person
        # at the keyboard: pam_fprintd verifies the target account's finger, so
        # switching identity can change the answer.
        #
        # `in_use` is the second half: an enrolled finger is worth nothing while the
        # device is claimed by somebody else's verification, because PAM's Claim will
        # fail within a blink and land on the password anyway. Promising a reader
        # that cannot answer is the one thing worse than not offering it.
        return self.ui.fp.enrolled(self.identity_uid) and not self.ui.fp.in_use

    def begin_msg(self):
        return {
            "type": "begin", "id": self.id, "kind": "password", "choice": "",
            "message": self.message, "icon": self.icon, "action": self.action_id,
            "user": self._current_name(),
            "users": [c["name"] for c in self.choices] if self.selectable else [],
            # Naming the account is only informative when it is NOT the obvious one.
            "self": self.identity_uid == os.getuid(),
            "fp": self.fp_stage,
        }

    def _send_begin(self):
        # Decided once per (re)opening and remembered: begin_msg is re-sent verbatim
        # to a shell that connects mid-prompt, and a card that re-derived the mode on
        # reconnect could contradict the conversation PAM is already having.
        self.fp_stage = self._fp_expected()
        self.ui.send(self.begin_msg())

    def start(self):
        if self.identity is None:
            self._finish("fail")
            return
        self._send_begin()
        self._new_session()

    def _new_session(self):
        self.awaiting = False
        self.pending = None
        self.saw_error = False
        # Every run of the stack starts at pam_fprintd again, so a retry really is
        # waiting on the reader once more (the card says so too) — unless the user
        # opted out, which is exactly what the gate makes the next run honour.
        self.fp_stage = (not self.fp_skipped) and self._fp_expected()
        self.session = PolkitAgent.Session.new(self.identity, self.cookie)
        self.session.connect("request", self._on_request)
        self.session.connect("show-info", self._on_info)
        self.session.connect("show-error", self._on_error)
        self.session.connect("completed", self._on_completed)
        self.session.initiate()

    def _stale(self, session):
        # A session we walked away from (identity switch) may still emit — its PAM
        # conversation unwinds on its own schedule. Ignore everything that does not
        # come from the session we are currently driving, so a dead conversation can
        # neither prompt the card nor count as a failed try.
        return session is not self.session

    def _on_request(self, session, prompt, echo):
        if self._stale(session):
            return
        # PAM asking for a password is also the moment the reader stops being waited
        # on, so nothing here has a fingerprint attempt left to abort.
        self.fp_stage = False
        # pam_fprintd may still be blocking when the user types: if a password is
        # already queued, answer immediately; otherwise ask the shell for one.
        if self.pending is not None:
            pw, self.pending = self.pending, None
            session.response(pw)
            return
        self.awaiting = True
        self.ui.send({"type": "request", "id": self.id, "prompt": prompt, "echo": bool(echo)})

    def _on_info(self, session, text):
        if self._stale(session):
            return
        self.ui.send({"type": "info", "id": self.id, "text": text})

    def _on_error(self, session, text):
        if self._stale(session):
            return
        # A real PAM message (e.g. faillock's "Account locked due to N failed
        # logins"). Surface it verbatim and remember we did, so the retry path below
        # does NOT overwrite it with a generic "Authentication failed".
        self.saw_error = True
        self.ui.send({"type": "error", "id": self.id, "text": text})

    def _on_completed(self, session, gained):
        if self._stale(session):
            return
        if gained:
            self._finish("ok")
            return
        if self.cancelled:
            self._finish("cancel")
            return
        self.tries += 1
        if self.tries < self.MAX_TRIES:
            # Retry in-place: tell the shell this try failed (it clears the field and
            # stays open), then spin a fresh session. Deferred to idle so the current
            # "completed" emission fully unwinds before we re-enter libpolkit-agent.
            # If PAM already gave a real reason (faillock lockout etc.), keep it.
            if not self.saw_error:
                self.ui.send({"type": "error", "id": self.id, "text": "Authentication failed"})
            GLib.idle_add(self._retry)
        else:
            self._finish("fail")

    def _retry(self):
        if not self.done:
            self._new_session()
        return GLib.SOURCE_REMOVE

    def select_identity(self, name):
        # Authenticate as a different administrator. PolkitAgent.Session.new() binds a
        # session to ONE identity, so switching means a new session, not a new value in
        # a field. We drop the old one rather than waiting for its "completed": that
        # signal is what the retry path listens to, and hanging the switch off it would
        # either double-spin a session or count the switch as a failed try. The stale
        # guard (_stale) keeps the abandoned conversation silent.
        if self.done or not self.selectable:
            return
        target = next((c for c in self.choices if c["name"] == name), None)
        if target is None or target["uid"] == self.identity_uid:
            return
        old = self.session
        self.session = None
        # The abandoned conversation would keep the reader for the rest of its
        # timeout, and the card we are about to re-send would then have to open in
        # password mode for a machine that does have a finger enrolled.
        if self.fp_stage:
            self.ui.fp.abort()
        if old is not None:
            try:
                old.cancel()
            except GLib.Error:
                pass
        self.identity_uid = target["uid"]
        self.identity = Polkit.UnixUser.new(self.identity_uid)
        self.tries = 0
        # A different account is a fresh decision about how to authenticate: the
        # card resets its own opt-out on the re-sent `begin`, so the PAM-side flag
        # has to come back with it or the two would disagree about what the next
        # session does.
        self.fp_skipped = False
        Fingerprint.set_skip(False)
        # Re-send `begin` (same id): the card already treats it as a fresh prompt —
        # clears the field, the error and the failure count — so no new message type
        # is needed, and it now carries the new name.
        self._send_begin()
        self._new_session()

    def skip_fingerprint(self):
        """The user asked for the password while the reader was still being waited on.

        Nothing can interrupt pam_fprintd from outside — it owns the conversation
        until its own max-tries/timeout run out — so the only way to make this
        immediate is to run the stack AGAIN with the fingerprint module skipped.
        The flag below is what /usr/lib/w/w-fp-gate reads to do that, and the
        session restart is the same stale-guard tactic select_identity uses: drop
        the old session and spin a new one, rather than waiting on `completed`,
        which the retry path owns and which would otherwise count this as a failed
        attempt. `tries` is deliberately untouched — the user changed method, they
        did not get anything wrong.

        Two mechanisms, two different jobs, and both are needed: the flag decides
        what the NEXT run of the stack does (and keeps deciding it across retries),
        while abort() ends the run we are walking away from — otherwise it would sit
        there holding the reader lit, and the very next prompt would find the device
        claimed. Cancelling the session does not do that job: since polkit 126 there
        is no child process to signal.
        """
        if self.done or self.fp_skipped:
            return
        self.fp_skipped = True
        Fingerprint.set_skip(True)
        old = self.session
        self.session = None
        if self.fp_stage:
            self.ui.fp.abort()
        if old is not None:
            try:
                old.cancel()
            except GLib.Error:
                pass
        self._new_session()

    def submit(self, password, choice=False):
        # polkit has no "choice" (that is a gcr/keyring concept) — ignore it here.
        if self.done:
            return
        if self.awaiting:
            self.awaiting = False
            self.session.response(password)
        else:
            self.pending = password   # request() has not arrived yet — queue it

    def cancel(self):
        if self.done:
            return
        self.cancelled = True
        # Dismissing the card must also put the reader out. The session cancel below
        # cannot: it has no helper process to signal, so pam_fprintd would keep the
        # sensor lit — and the device claimed — for the rest of its timeout.
        if self.fp_stage:
            self.ui.fp.abort()
        if self.session is not None:   # None if cancelled while still queued
            try:
                self.session.cancel()  # → completed(False) → _finish("cancel")
            except GLib.Error:
                pass
        if not self.done:
            self._finish("cancel")

    def _finish(self, result):
        if self.done:
            return
        self.done = True
        self.fp_stage = False
        # The skip is scoped to ONE prompt. Leaving it behind would silently disable
        # the reader for every later polkit action in this session — the one failure
        # of this design that would look like "fingerprint stopped working".
        if self.fp_skipped:
            Fingerprint.set_skip(False)
        self.ui.send({"type": "end", "id": self.id, "result": result})
        self.ui.finish(self)           # clears active + promotes the next queued prompt
        self.agent.forget(self.cookie)
        # Complete the pending D-Bus call. Success reports the gained authorization
        # to polkitd; failure/cancel return the matching PolicyKit1 error so pkexec &
        # friends see a clean dismissal instead of a hang.
        if result == "ok":
            self.invocation.return_value(GLib.Variant("()", ()))
        elif result == "cancel":
            self.invocation.return_dbus_error(
                "org.freedesktop.PolicyKit1.Error.Cancelled", "Authentication cancelled"
            )
        else:
            self.invocation.return_dbus_error(
                "org.freedesktop.PolicyKit1.Error.Failed", "Authentication failed"
            )


class Agent:
    """Exports the AuthenticationAgent D-Bus object and registers it with polkitd."""

    def __init__(self, ui):
        self.ui = ui
        self.by_cookie = {}
        self.node = Gio.DBusNodeInfo.new_for_xml(AGENT_XML)
        self.bus = None
        self.reg_id = None
        self.authority = None
        self.subject = None

    def register(self):
        # The AuthenticationAgent lives on the SYSTEM bus; polkitd calls back to our
        # unique name + object path. Polkit.Authority.get_sync shares the same singleton
        # system-bus connection, so the name it registers matches the one we export on.
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        # register_object is deprecated in favour of the *_with_closures2 variant
        # (same signature here); fall back on older GLib that lacks it.
        reg = getattr(self.bus, "register_object_with_closures2", self.bus.register_object)
        self.reg_id = reg(
            OBJECT_PATH, self.node.interfaces[0], self._on_call, None, None
        )
        self.authority = Polkit.Authority.get_sync(None)
        self.subject = Polkit.UnixSession.new_for_process_sync(os.getpid(), None)
        locale = os.environ.get("LANG") or "en_US.UTF-8"
        self.authority.register_authentication_agent_sync(
            self.subject, locale, OBJECT_PATH, None
        )

    def unregister(self):
        try:
            if self.authority and self.subject:
                self.authority.unregister_authentication_agent_sync(
                    self.subject, OBJECT_PATH, None
                )
        except GLib.Error:
            pass
        if self.bus and self.reg_id:
            self.bus.unregister_object(self.reg_id)

    def forget(self, cookie):
        self.by_cookie.pop(cookie, None)

    def _on_call(self, conn, sender, path, iface, method, params, invocation):
        if method == "BeginAuthentication":
            action_id, message, icon, _details, cookie, identities = params.unpack()
            req = AuthRequest(self.ui, self, action_id, message, icon,
                              cookie, identities, invocation)
            self.by_cookie[cookie] = req
            self.ui.enqueue(req)       # shown now if idle, else queued (one at a time)
        elif method == "CancelAuthentication":
            (cookie,) = params.unpack()
            req = self.by_cookie.get(cookie)
            if req:
                req.cancel()
            invocation.return_value(GLib.Variant("()", ()))
        else:
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod", method
            )


# ── gcr / keyring bridge ─────────────────────────────────────────────────────
# We own org.gnome.keyring.SystemPrompter on the SESSION bus and implement the
# org.gnome.keyring.internal.Prompter interface by hand (Gcr.SystemPrompter + a
# Python Gcr.Prompt segfaults the same way PolkitAgent.Listener does). Callers
# (gcr-ssh-agent, gnome-keyring-daemon) then send their SSH/keyring passphrase
# prompts to us. The password is carried encrypted via GcrSecretExchange, which we
# drive by hand: begin() (our public key) in the first PromptReady, receive() the
# caller's key on PerformPrompt, send(password) back in the final PromptReady.

GCR_PROMPTER_NAME = "org.gnome.keyring.SystemPrompter"
GCR_PROMPTER_PATH = "/org/gnome/keyring/Prompter"
GCR_CALLBACK_IFACE = "org.gnome.keyring.internal.Prompter.Callback"
GCR_PROMPTER_XML = """
<node>
  <interface name="org.gnome.keyring.internal.Prompter">
    <method name="BeginPrompting">
      <arg type="o" name="callback" direction="in"/>
    </method>
    <method name="PerformPrompt">
      <arg type="o" name="callback" direction="in"/>
      <arg type="s" name="type" direction="in"/>
      <arg type="a{sv}" name="properties" direction="in"/>
      <arg type="s" name="exchange" direction="in"/>
    </method>
    <method name="StopPrompting">
      <arg type="o" name="callback" direction="in"/>
    </method>
  </interface>
</node>
"""


class GcrRequest:
    """One PerformPrompt shown as a card. Mirrors AuthRequest's UI-facing surface."""

    def __init__(self, ui, prompter, session, kind, props):
        self.ui = ui
        self.prompter = prompter
        self.session = session
        self.kind = kind or "password"
        # gcr splits the human text across message/description; the card has one
        # subtitle slot, so prefer the description (the specific line, e.g. the key
        # path) and fall back to the generic message.
        self.message = props.get("description") or props.get("message") or ""
        self.choice = props.get("choice-label") or ""
        self.id = ui.next_id()
        self.done = False

    def begin_msg(self):
        return {
            "type": "begin", "id": self.id, "kind": self.kind,
            "message": self.message, "icon": "", "action": "", "choice": self.choice,
            # A gcr prompt names no identity at all (`user` is absent), so the card
            # has nothing to label; `self` is stated only to keep the shape uniform.
            "self": True,
            # gcr prompts never run PAM: a keyring/SSH passphrase is the secret
            # itself, not a credential a reader could stand in for.
            "fp": False,
        }

    def start(self):
        # The prompt is already "ready" (gcr did the PAM/keyring work); we just need
        # the user's input. No PolkitAgent.Session to spin, so start = show the card.
        self.ui.send(self.begin_msg())

    def submit(self, password, choice=False):
        if self.done:
            return
        self._finish("ok", password, choice)

    def cancel(self):
        if self.done:
            return
        self._finish("cancel", "", False)

    def _finish(self, result, secret, chosen):
        if self.done:
            return
        self.done = True
        # "yes" = confirmed / password entered; "no" = dismissed. The caller decides
        # if the passphrase was correct — on a wrong one it opens a fresh PerformPrompt
        # (a new card), the same way polkit re-initiates.
        self.prompter.send_result(self.session, "yes" if result == "ok" else "no",
                                  secret, chosen)
        if self.session.get("active") is self:
            self.session["active"] = None
        self.ui.send({"type": "end", "id": self.id, "result": result})
        self.ui.finish(self)


class GcrPrompter:
    """Owns org.gnome.keyring.SystemPrompter and speaks the internal Prompter protocol."""

    def __init__(self, ui):
        self.ui = ui
        self.conn = None
        self.reg_id = None
        self.owner_id = None
        self.sessions = {}          # (sender, callback_path) -> session dict
        self.node = Gio.DBusNodeInfo.new_for_xml(GCR_PROMPTER_XML)

    def register(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reg = getattr(self.conn, "register_object_with_closures2", self.conn.register_object)
        self.reg_id = reg(
            GCR_PROMPTER_PATH, self.node.interfaces[0], self._on_call, None, None
        )
        # Own the name so gcr-prompter is never D-Bus-activated in our place. NONE
        # (no REPLACE): if a real prompter somehow already holds it, we stand down
        # rather than fight, and the gcr half is simply inactive.
        self.owner_id = Gio.bus_own_name_on_connection(
            self.conn, GCR_PROMPTER_NAME, Gio.BusNameOwnerFlags.NONE, None, None
        )

    def _new_exchange(self):
        return Gcr.SecretExchange.new(Gcr.SECRET_EXCHANGE_PROTOCOL_1)

    def _on_call(self, conn, sender, path, iface, method, params, invocation):
        if method == "BeginPrompting":
            (cb_path,) = params.unpack()
            key = (sender, cb_path)
            watch = Gio.bus_watch_name_on_connection(
                conn, sender, Gio.BusNameWatcherFlags.NONE,
                None, lambda c, n: self._drop(key)
            )
            self.sessions[key] = {
                "sender": sender, "path": cb_path,
                "se": self._new_exchange(), "active": None, "watch": watch,
            }
            invocation.return_value(GLib.Variant("()", ()))
            # First ready carries OUR public key (begin), no secret yet.
            self._call_ready(self.sessions[key], "none", {}, self.sessions[key]["se"].begin())
        elif method == "PerformPrompt":
            cb_path, ptype, props, exchange = params.unpack()
            sess = self.sessions.get((sender, cb_path))
            if sess is None:
                invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed",
                                             "no prompting session")
                return
            sess["se"].receive(exchange)          # ingest the caller's public key
            invocation.return_value(GLib.Variant("()", ()))
            req = GcrRequest(self.ui, self, sess, ptype, props)
            sess["active"] = req
            self.ui.enqueue(req)                  # shown now if idle, else queued
        elif method == "StopPrompting":
            (cb_path,) = params.unpack()
            self._drop((sender, cb_path))
            invocation.return_value(GLib.Variant("()", ()))
        else:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def send_result(self, sess, reply, secret, chosen):
        # received is always true by now (we got the caller's key on PerformPrompt),
        # so the reply exchange carries the secret; choice-chosen rides in properties
        # (that is what makes gcr-ssh-agent persist the passphrase into the keyring).
        exchange = sess["se"].send(secret or "", -1)
        # gcr's client double-unwraps each a{sv} value (it g_variant_get_variant()s the
        # value it already pulled out of the sv), so property values must be wrapped
        # as a variant-in-a-variant: v(v(b)) on the wire, not a bare v(b).
        props = {"choice-chosen": GLib.Variant("v", GLib.Variant("b", chosen))}
        self._call_ready(sess, reply, props, exchange)

    def _call_ready(self, sess, reply, props, exchange):
        body = GLib.Variant("(sa{sv}s)", (reply, props, exchange or ""))
        self.conn.call(
            sess["sender"], sess["path"], GCR_CALLBACK_IFACE, "PromptReady",
            body, None, Gio.DBusCallFlags.NONE, -1, None, None
        )

    def _drop(self, key):
        sess = self.sessions.pop(key, None)
        if not sess:
            return
        if sess.get("watch"):
            Gio.bus_unwatch_name(sess["watch"])
        active = sess.get("active")
        if active and not active.done:
            active.done = True
            self.ui.send({"type": "end", "id": active.id, "result": "cancel"})
            self.ui.finish(active)

    def unregister(self):
        if self.owner_id:
            Gio.bus_unown_name(self.owner_id)
        if self.conn and self.reg_id:
            self.conn.unregister_object(self.reg_id)


# ── LockSensor ─────────────────────────────────────────────────────────────────
# Fingerprint verification FOR the lock screen, duty-cycled (`w-fingerprint
# lock-sensor mode wake`). hyprlock's native integration holds VerifyStart for the
# whole lock, and a reader without hardware finger-detect (uru4000) overheats in
# libfprint's thermal model after ~4 min: fprintd reports verify-disconnected and
# hyprlock 0.9.6 never tries again (upstream #1067). In wake mode hyprlock's
# fingerprint is off (hyprlock-auth.conf) and this object verifies instead, only
# for a WINDOW after lock / wake-from-sleep / activity while locked (hypridle's
# 5 s listener → `w-fingerprint lock-sensor _arm` → Arm(u)). A match sends
# hyprlock SIGUSR1 — its one external control, meaning "unlock".
#
# Exported on the session bus: com.w.authd /com/w/authd com.w.authd.LockSensor —
# Arm(u seconds) · Disarm() · Status() → "state=… locked=… mode=… attempts=…".
#
# ⚠️ The verification is a CHILD PROCESS (`fprintd-verify <user>`), not a D-Bus
# call of our own, for the reason _lamp_off documents at length: fprintd frees the
# reader — and the uru4000's lamp goes out — on the CLIENT VANISHING, which a
# process exit signals unambiguously and a GDBus connection close does not (tried;
# the reader stayed claimed and every later polkit prompt fell back to the
# password). So arm = spawn, disarm = SIGKILL, and the retry after a no-match is
# simply the next spawn. The verdict is read off the tool's stdout ("Verify
# result: verify-match (done)"); a kill of our own is never a verdict.
#
# "Locked" is the w-lock scope — lock_cmd (w-power) runs hyprlock as
# `systemd-run --user --scope --unit=w-lock`, so `systemd --user` announces the
# lock screen's start and end over PropertiesChanged/UnitRemoved (after
# Manager.Subscribe, without which it announces nothing). A hyprlock started by
# hand has no scope: Arm is ignored, exactly as documented in `w-fingerprint help`.

LOCK_SENSOR_NAME = "com.w.authd"
LOCK_SENSOR_PATH = "/com/w/authd"
LOCK_SENSOR_IFACE = "com.w.authd.LockSensor"
LOCK_SENSOR_XML = f"""
<node>
  <interface name="{LOCK_SENSOR_IFACE}">
    <method name="Arm"><arg type="u" name="seconds" direction="in"/></method>
    <method name="Disarm"/>
    <method name="Status"><arg type="s" name="status" direction="out"/></method>
  </interface>
</node>
"""
LOCK_SCOPE_UNIT = "w-lock.scope"
LOCK_SCOPE_PATH = "/org/freedesktop/systemd1/unit/w_2dlock_2escope"
SYSTEMD_NAME = "org.freedesktop.systemd1"
SYSTEMD_PATH = "/org/freedesktop/systemd1"
SYSTEMD_MANAGER = "org.freedesktop.systemd1.Manager"
SYSTEMD_UNIT = "org.freedesktop.systemd1.Unit"


class LockSensor:
    """State: idle (no child) · armed (fprintd-verify alive, window timer running)
    · cooldown (the reader refused or gave up — verify-disconnected, a busy Claim,
    no fingers, MAX_ATTEMPTS no-matches — wait COOLDOWN_SEC before the next Arm).
    Unlock, sleep and Disarm all end in idle; every transition out of armed kills
    the child, which is what releases the reader."""

    MAX_ATTEMPTS = 3          # no-matches before a cooldown, like hyprlock's own loop
    COOLDOWN_SEC = 60
    RETRY_MS = 250            # breath between a no-match exit and the next spawn
    MAX_WINDOW = 300          # LOCK_SENSOR_ARM's own ceiling; a bus peer gets no more
    TIMEOUT_MS = 3000
    # The one line that means "unlock" — the whole line, not a substring: every
    # other verdict fprintd-verify prints (verify-no-match, verify-retry-scan,
    # verify-disconnected…) must stay a non-event however the tool phrases it.
    MATCH_LINE = "Verify result: verify-match (done)"

    def __init__(self, fp):
        self.fp = fp                  # Fingerprint: the enrolled-cache guard
        self.bus = None
        self.sys_bus = None
        self.reg_id = None
        self.owner_id = None
        self.locked = False           # w-lock.scope active
        self.mode = "native"          # LOCK_SENSOR, read at lock time
        self.window = 30              # LOCK_SENSOR_ARM, same
        self.child = None             # Gio.Subprocess while armed
        self.attempts = 0             # no-matches since the last (re)arm cycle
        self.window_src = None        # GLib source ids
        self.cooldown_src = None
        self.retry_src = None
        try:
            self.name = pwd.getpwuid(os.getuid()).pw_name
        except KeyError:
            self.name = ""

    @property
    def state(self):
        if self.cooldown_src is not None:
            return "cooldown"
        return "armed" if self.child is not None else "idle"

    # ── registration ─────────────────────────────────────────────────────────
    def register(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        node = Gio.DBusNodeInfo.new_for_xml(LOCK_SENSOR_XML)
        reg = getattr(self.bus, "register_object_with_closures2", self.bus.register_object)
        self.reg_id = reg(LOCK_SENSOR_PATH, node.interfaces[0], self._on_call, None, None)
        self.owner_id = Gio.bus_own_name_on_connection(
            self.bus, LOCK_SENSOR_NAME, Gio.BusNameOwnerFlags.NONE, None, None
        )
        # systemd emits unit PropertiesChanged only to subscribed peers.
        self.bus.call(
            SYSTEMD_NAME, SYSTEMD_PATH, SYSTEMD_MANAGER, "Subscribe", None, None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, self._ignore, None,
        )
        self.bus.signal_subscribe(
            SYSTEMD_NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            LOCK_SCOPE_PATH, SYSTEMD_UNIT, Gio.DBusSignalFlags.NONE, self._on_scope, None,
        )
        # A finished scope is unloaded at once; the removal is the surer "unlocked".
        self.bus.signal_subscribe(
            SYSTEMD_NAME, SYSTEMD_MANAGER, "UnitRemoved", SYSTEMD_PATH, LOCK_SCOPE_UNIT,
            Gio.DBusSignalFlags.NONE, lambda *_: self._set_locked(False), None,
        )
        self.sys_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.sys_bus.signal_subscribe(
            "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
            "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, self._on_sleep, None,
        )
        # Started under a live lock (daemon restart): read the scope, don't assume.
        self.bus.call(
            SYSTEMD_NAME, SYSTEMD_PATH, SYSTEMD_MANAGER, "GetUnit",
            GLib.Variant("(s)", (LOCK_SCOPE_UNIT,)), None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, self._on_get_unit, None,
        )

    def unregister(self):
        self._disarm()
        if self.owner_id:
            Gio.bus_unown_name(self.owner_id)
        if self.bus and self.reg_id:
            self.bus.unregister_object(self.reg_id)

    @staticmethod
    def _ignore(conn, res, _data):
        try:
            conn.call_finish(res)
        except GLib.Error:
            pass

    # ── D-Bus surface ────────────────────────────────────────────────────────
    def _on_call(self, conn, sender, path, iface, method, params, invocation):
        if method == "Arm":
            self._arm(params.unpack()[0])
            invocation.return_value(None)
        elif method == "Disarm":
            self._disarm()
            invocation.return_value(None)
        elif method == "Status":
            invocation.return_value(GLib.Variant("(s)", (self.status(),)))
        else:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def status(self):
        return (f"state={self.state} locked={'yes' if self.locked else 'no'} "
                f"mode={self.mode} attempts={self.attempts}")

    # ── lock / sleep tracking ────────────────────────────────────────────────
    def _on_get_unit(self, conn, res, _data):
        try:
            (path,) = conn.call_finish(res).unpack()
        except GLib.Error:
            return                    # NoSuchUnit: not locked
        conn.call(
            SYSTEMD_NAME, path, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", (SYSTEMD_UNIT, "ActiveState")), None,
            Gio.DBusCallFlags.NONE, self.TIMEOUT_MS, None, self._on_active_state, None,
        )

    def _on_active_state(self, conn, res, _data):
        try:
            (state,) = conn.call_finish(res).unpack()
        except GLib.Error:
            return
        self._set_locked(state == "active")

    def _on_scope(self, _conn, _sender, _path, _iface, _signal, params, _data):
        state = params.unpack()[1].get("ActiveState")
        if state == "active":
            self._set_locked(True)
        elif state in ("inactive", "failed"):
            self._set_locked(False)

    def _set_locked(self, locked):
        if locked == self.locked:
            return
        self.locked = locked
        self.attempts = 0
        self._clear(("cooldown_src",))
        if locked:
            self._read_conf()
        else:
            self._disarm()

    def _read_conf(self):
        # The layered config through the one sanctioned reader (w-conf.md): the mode
        # decides whether a lock arms at all, the window how long. Read once per
        # lock — the Hub cannot change either under a lock screen anyway.
        try:
            proc = Gio.Subprocess.new(
                ["/usr/bin/w-conf", "list", "fingerprint", "--porcelain"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error:
            return
        proc.communicate_utf8_async(None, None, self._on_conf, None)

    def _on_conf(self, proc, res, _data):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(res)
        except GLib.Error:
            return
        for line in (out or "").splitlines():
            f = line.split("\t")
            if len(f) < 2:
                continue
            if f[0] == "LOCK_SENSOR":
                self.mode = f[1]
            elif f[0] == "LOCK_SENSOR_ARM" and f[1].isdigit():
                self.window = int(f[1])
        if self.locked and self.mode == "wake":
            self._arm(self.window)

    def _on_sleep(self, _conn, _sender, _path, _iface, _signal, params, _data):
        (sleeping,) = params.unpack()
        if sleeping:
            self._disarm()            # the reader must not be mid-capture across suspend
        elif self.locked and self.mode == "wake":
            self._arm(self.window)    # lid opens onto a lit sensor

    # ── arm / disarm ─────────────────────────────────────────────────────────
    def _arm(self, seconds):
        # Not under our lock, cooling down, or nothing to match against: a no-op.
        # Under a native-mode lock hyprlock owns the reader; `_arm` never gets here
        # (hypridle's tick is rendered in wake mode only) but the guard is cheap.
        if (not self.locked or self.mode != "wake" or self.cooldown_src is not None
                or not self.fp.enrolled(os.getuid())):
            return
        self._clear(("window_src",))
        seconds = min(max(int(seconds), 1), self.MAX_WINDOW)
        self.window_src = GLib.timeout_add_seconds(seconds, self._on_window)
        if self.child is None:
            self._spawn()

    def _disarm(self):
        self._clear(("window_src", "retry_src"))
        self._kill()

    def _on_window(self):
        self.window_src = None
        self._disarm()
        return GLib.SOURCE_REMOVE

    def _clear(self, names):
        for n in names:
            src = getattr(self, n)
            if src is not None:
                GLib.source_remove(src)
                setattr(self, n, None)

    def _spawn(self):
        if not self.name or not os.access(Fingerprint.VERIFY_BIN, os.X_OK):
            self._cooldown()
            return
        try:
            self.child = Gio.Subprocess.new(
                [Fingerprint.VERIFY_BIN, self.name],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error:
            self._cooldown()
            return
        self.child.communicate_utf8_async(None, None, self._on_child, None)

    def _kill(self):
        # Gio.Subprocess drops its pid on reap, so a late signal can never reach a
        # recycled number — the guard _lamp_off has to keep by hand.
        proc, self.child = self.child, None
        if proc is not None:
            proc.send_signal(signal.SIGKILL)

    def _on_child(self, proc, res, _data):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(res)
        except GLib.Error:
            out = ""
        if proc is not self.child:
            return                    # our own kill: not a verdict
        self.child = None
        lines = (out or "").splitlines()
        if self.MATCH_LINE in lines:
            self._unlock()
        elif any(line.startswith("Verify result: verify-no-match") for line in lines):
            self.attempts += 1
            if self.attempts >= self.MAX_ATTEMPTS:
                self._cooldown()
            elif self.window_src is not None:
                self.retry_src = GLib.timeout_add(self.RETRY_MS, self._retry)
        else:
            # Claim refused (busy), verify-disconnected (libfprint's overheat guard),
            # no fingers, fprintd gone: nothing a faster retry would change.
            self._cooldown()

    def _retry(self):
        self.retry_src = None
        if self.locked and self.child is None and self.window_src is not None:
            self._spawn()
        return GLib.SOURCE_REMOVE

    def _unlock(self):
        self.attempts = 0
        self._disarm()
        try:
            Gio.Subprocess.new(
                ["/usr/bin/pkill", "-USR1", "-x", "-u", str(os.getuid()), "hyprlock"],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error:
            pass

    def _cooldown(self):
        self._disarm()
        self._clear(("cooldown_src",))
        self.cooldown_src = GLib.timeout_add_seconds(self.COOLDOWN_SEC, self._on_cooldown)

    def _on_cooldown(self):
        self.cooldown_src = None
        self.attempts = 0             # the next activity tick arms again
        return GLib.SOURCE_REMOVE


def main():
    ui = AuthUI(sock_path())
    ui.start()
    # Warm the fingerprint cache for the session's own user right away: the daemon
    # starts at login, the first prompt comes seconds-to-minutes later, so the
    # answer is already there when it matters and no prompt ever waits on fprintd.
    ui.fp.refresh(os.getuid())
    # A crash (or a kill) mid-prompt could have left the skip flag behind, which
    # would disable the reader for the whole session with nothing to point at.
    # Clearing it unconditionally at start makes that unrecoverable state impossible.
    Fingerprint.set_skip(False)

    agent = Agent(ui)
    try:
        agent.register()
    except GLib.Error as e:
        print(f"w-authd: failed to register polkit agent: {e}", file=sys.stderr)
        return 1

    prompter = None
    if HAVE_GCR:
        prompter = GcrPrompter(ui)
        try:
            prompter.register()
        except GLib.Error as e:
            # gcr bridge is best-effort: a failure here must not take polkit down.
            print(f"w-authd: gcr prompter unavailable: {e}", file=sys.stderr)
            prompter = None

    lock_sensor = LockSensor(ui.fp)
    try:
        lock_sensor.register()
    except GLib.Error as e:
        print(f"w-authd: lock sensor unavailable: {e}", file=sys.stderr)
        lock_sensor = None

    loop = GLib.MainLoop()

    def shutdown(*_):
        agent.unregister()
        if prompter is not None:
            prompter.unregister()
        if lock_sensor is not None:
            lock_sensor.unregister()
        try:
            os.unlink(ui.path)
        except FileNotFoundError:
            pass
        loop.quit()
        return GLib.SOURCE_REMOVE

    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)
    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)

    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
