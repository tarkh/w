{
  "_comment": "W Linux — system-wide Firefox enterprise policy (apply.sh --firefox). Authoritative, applies to every profile; cannot be flipped back from the UI. Conservative privacy defaults that do NOT break sites.",
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFeedbackCommands": true,
    "DisableDefaultBrowserAgent": true,
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true
    },
    "FirefoxHome": {
      "Pocket": false,
      "SponsoredPocket": false,
      "SponsoredTopSites": false,
      "Snippets": false
    }
  }
}
