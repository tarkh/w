# W Linux — Ghostty terminal (W-Terminal: GUI/truecolor-first primary surface).
# Colors live in themes/w (generated by w-style from the active theme's theme.conf).

theme = w

# ── Font (rendered by `w-style apply font` from the active theme's font.conf) ──
# JetBrainsMono Nerd Font carries powerline + icon glyphs used by the prompt/eza.
font-family = JetBrainsMono Nerd Font
font-size = 11
font-feature = -calt
font-feature = -liga
font-feature = -dlig
adjust-cell-height = 8%

# ── Tiling WM (Hyprland): no client-side decorations ──────────────────────────
window-decoration = false
gtk-titlebar = false

# ── Hyprland: epoll backend fixes GTK rendering performance ───────────────────
async-backend = epoll

# ── Aesthetic: breathing room ─────────────────────────────────────────────────
# background-opacity is driven by the effects axis (W_FX_TERM_OPACITY), rendered into
# the theme file (themes/w) which `theme = w` above loads — do NOT set it here, a key
# after `theme =` would override the theme file. Blur behind the translucent terminal
# is owned entirely by Hyprland (effects.conf W_FX_BLUR_*); Ghostty's own background-blur
# is a compositor hint Hyprland does not implement (a no-op here), so it is omitted.
window-padding-x = 10
window-padding-y = 6
window-padding-balance = true
window-padding-color = background
# Any GTK chrome / command palette follows the terminal colours, not libadwaita.
window-theme = ghostty
# Exact theme palette: never auto-brighten bold text to the bright ANSI slot.
bold-is-bright = false

# ── Shell integration (cwd inheritance, prompt marks, cursor/sudo hints) ──────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Behavior ──────────────────────────────────────────────────────────────────
# Daemon lifecycle (systemd/D-Bus model — see package-ghostty.md). The user
# service app-com.mitchellh.ghostty.service is enabled at login (mod_hyprland),
# so the GTK process is pre-warmed and `ghostty +new-window` (the Super+Return
# bind) opens surfaces of this one daemon in ~20ms instead of spawning a fresh
# ~300ms process per window. Five minutes after the last window closes the daemon
# quits to free memory; the next open pays a single cold D-Bus activation.
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# Under tiling Hyprland resizes are constant; the size popup is noise and its GTK
# (libadwaita) styling doesn't follow the terminal theme. Suppress it.
resize-overlay = never
