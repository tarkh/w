#!/usr/bin/ash
# shellcheck shell=dash
# mkinitcpio runtime hook — busybox initramfs only (plain/GRUB installs).
#
# Shebang is /usr/bin/ash like every stock hook in /usr/lib/initcpio/hooks: the
# only shell the busybox image has. mkinitcpio's add_runscript adds the
# interpreter named here, so pointing at bash would pull bash into the image (and
# warn that it is missing on the build host).
#
# The systemd initramfs used by W's encrypted installs never calls run_hook; there
# the very same setter is started by the w-kbdlight.service unit the install hook
# bakes in. Both paths converge on /usr/lib/w/w-kbdlight-boot, so the
# behaviour has exactly one implementation. See /etc/initcpio/install/w-kbdlight.

run_hook() {
    sh /usr/lib/w/w-kbdlight-boot 2>/dev/null || true
}
